  <TR STYLE="vertical-align: top">
    <TD STYLE="width: 0.9in">&nbsp;</TD>
    <TD STYLE="width: 0.5in; text-align: justify; font-size: 10pt"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">7.1.7</FONT></TD>
    <TD STYLE="text-align: justify; font-size: 10pt"><FONT STYLE="font-family: Times New Roman, Times, Serif; font-size: 10pt">any approval, license, permit or authorization of a governmental authority that renders this Agreement enforceable, lawful and effective is withdrawn, suspended, invalidated or materially amended;</FONT></TD></TR>
