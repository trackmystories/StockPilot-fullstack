<ix:nonNumeric contextRef="From2025-01-01to2025-12-31" escape="true" id="Fact000959" name="us-gaap:BasisOfAccountingPolicyPolicyTextBlock"><p id="xdx_84E_eus-gaap--BasisOfAccountingPolicyPolicyTextBlock_zOPHK5svFrta" style="font: 10pt Times New Roman, Times, Serif; margin: 0 0 0 18pt; text-align: justify">&#160;</p>

