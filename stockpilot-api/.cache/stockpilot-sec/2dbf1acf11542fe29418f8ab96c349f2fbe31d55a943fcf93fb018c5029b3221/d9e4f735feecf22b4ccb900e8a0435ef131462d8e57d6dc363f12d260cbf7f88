bceaa38a3eb07e3127b62139035e5c1f1770efe699303bb2456068073c32efe8{"version":1,"source":{"accession":"0001555280-26-000040","form":"10-Q","filedAt":"2026-08-06","reportDate":"2026-06-30","cik":"0001555280","url":"https://www.sec.gov/Archives/edgar/data/1555280/000155528026000040/zts-20260630.htm","rawPath":"sec/raw/c999b86479da71ae484345554e54e255d85523fda80ab63fcb8878e4af9747b4.bin","sha256":"c999b86479da71ae484345554e54e255d85523fda80ab63fcb8878e4af9747b4"},"layers":{"businessProfile":{"status":"evidence_available","evidence":[{"id":"9b60f630daba5eba2437a5003818602daac9732a6e99d3449655eba10fb0943b","quote":"Zoetis is a global leader in the animal health industry, focused on the discovery, development, manufacture and commercialization of medicines, vaccines, diagnostic products and services, biodevices, genetic tests and precision animal health. With a legacy of nearly 75 years, we continue to pioneer ways to predict, prevent, detect, and treat animal illness, supporting those raising and caring for animals worldwide - from veterinarians and pet owners to livestock producers.","context":"Overview of our business","section":"Overview of our business","block":339,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001555280-26-000040","form":"10-Q","filedAt":"2026-08-06","reportDate":"2026-06-30","cik":"0001555280","url":"https://www.sec.gov/Archives/edgar/data/1555280/000155528026000040/zts-20260630.htm","rawPath":"sec/raw/c999b86479da71ae484345554e54e255d85523fda80ab63fcb8878e4af9747b4.bin","sha256":"c999b86479da71ae484345554e54e255d85523fda80ab63fcb8878e4af9747b4"}},{"id":"2d4d0eafbdd4c913bd7275ddd7eb88a3e2f6550ba01034ecd592e2d7a0a970c8","quote":"We manage our operations through two geographic operating segments: the United States (U.S.) and International. Within each of these operating segments, we offer diverse products for both companion animals and livestock customers in order to capitalize on local and regional trends and customer needs. See Notes to Condensed Consolidated Financial Statements — Note 16. Segment Information.","context":"Zoetis is a global leader in the animal health industry, focused on the discovery, development, manufacture and commercialization of medicines, vaccines, diagnostic products and services, biodevices, genetic tests and precision animal health. With a legacy of nearly 75 years, we continue to pioneer ways to predict, prevent, detect, and treat animal illness, supporting those raising and caring for animals worldwide - from veterinarians and pet owners to livestock producers.","section":"Overview of our business","block":340,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001555280-26-000040","form":"10-Q","filedAt":"2026-08-06","reportDate":"2026-06-30","cik":"0001555280","url":"https://www.sec.gov/Archives/edgar/data/1555280/000155528026000040/zts-20260630.htm","rawPath":"sec/raw/c999b86479da71ae484345554e54e255d85523fda80ab63fcb8878e4af9747b4.bin","sha256":"c999b86479da71ae484345554e54e255d85523fda80ab63fcb8878e4af9747b4"}},{"id":"c17244ec2379b147ad7c226b17f123facb4ce8c207160d627c279bc2734f6012","quote":"We directly market our products to veterinarians and livestock producers located in approximately 45 countries across North America, Europe, Africa, Asia, Australia and South America, and are a market leader in nearly all of the major regions in which we operate. In markets where we do not have a direct commercial presence, we generally contract with distributors that provide logistics and sales and marketing support for our products.","context":"We manage our operations through two geographic operating segments: the United States (U.S.) and International. Within each of these operating segments, we offer diverse products for both companion animals and livestock customers in order to capitalize on local and regional trends and customer needs. See Notes to Condensed Consolidated Financial Statements — Note 16. Segment Information.","section":"Overview of our business","block":341,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001555280-26-000040","form":"10-Q","filedAt":"2026-08-06","reportDate":"2026-06-30","cik":"0001555280","url":"https://www.sec.gov/Archives/edgar/data/1555280/000155528026000040/zts-20260630.htm","rawPath":"sec/raw/c999b86479da71ae484345554e54e255d85523fda80ab63fcb8878e4af9747b4.bin","sha256":"c999b86479da71ae484345554e54e255d85523fda80ab63fcb8878e4af9747b4"}},{"id":"cc0ac69d81d2b378765dc4bea0c79bf3f42c7dd3d92687d386d5bc1164d6c803","quote":"Our companion animal and livestock products are primarily available by prescription through a veterinarian. On a more limited basis, in certain markets, we sell certain products through retail and e-commerce outlets. We also market our products by advertising to veterinarians, pet owners and livestock producers.","context":"We directly market our products to veterinarians and livestock producers located in approximately 45 countries across North America, Europe, Africa, Asia, Australia and South America, and are a market leader in nearly all of the major regions in which we operate. In markets where we do not have a direct commercial presence, we generally contract with distributors that provide logistics and sales and marketing support for our products.","section":"Overview of our business","block":342,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001555280-26-000040","form":"10-Q","filedAt":"2026-08-06","reportDate":"2026-06-30","cik":"0001555280","url":"https://www.sec.gov/Archives/edgar/data/1555280/000155528026000040/zts-20260630.htm","rawPath":"sec/raw/c999b86479da71ae484345554e54e255d85523fda80ab63fcb8878e4af9747b4.bin","sha256":"c999b86479da71ae484345554e54