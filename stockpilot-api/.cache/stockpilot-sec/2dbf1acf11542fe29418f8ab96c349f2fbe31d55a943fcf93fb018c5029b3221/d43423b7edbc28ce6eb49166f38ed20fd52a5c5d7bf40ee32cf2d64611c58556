pt;width:100%"><div style="margin-bottom:9pt;text-indent:18pt"><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:144%;text-decoration:underline"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:144%;text-decoration:underline" href="#i65586316059c45a59ae05374291033aa_7">Table of Conten</a><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:144%;text-decoration:underline" href="#i65586316059c45a59ae05374291033aa_7">t</a><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:144%;text-decoration:underline" href="#i65586316059c45a59ae05374291033aa_7">s</a></span></div></div><ix:continuation id="f-504-2"><div style="margin-bottom:9pt;margin-top:12pt;text-indent:18pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-style:italic;font-weight:700;line-height:144%">Contract Liabilities</span></div><div style="margin-bottom:9pt;margin-top:6pt;text-align:justify;text-indent:25pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:144%">In fiscal 2026, fiscal 2025 and fiscal 2024 we recognized revenue of $<ix:nonFraction unitRef="usd" contextRef="c-1" decimals="-5" name="us-gaap:ContractWithCustomerLiabilityRevenueRecognized" format="ixt:num-dot-decimal" scale="6" id="f-559">2,053.4</ix:nonFraction> million, $<ix:nonFraction unitRef="usd" contextRef="c-7" decimals="-5" name="us-gaap:ContractWithCustomerLiabilityRevenueRecognized" format="ixt:num-dot-decimal" scale="6" id="f-560">1,643.1</ix:nonFraction> million and $<ix:nonFraction unitRef="usd" contextRef="c-8" decimals="-5" name="us-gaap:ContractWithCustomerLiabilityRevenueRecognized" format="ixt:num-dot-decimal" scale="6" id="f-561">1,277.8</ix:nonFraction> million, respectively, that was included in the corresponding contract liabi