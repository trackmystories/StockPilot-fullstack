.sec.gov/Archives/edgar/data/110471/000162828026012614/a2025-q4ex1013thirdamendme.htm","rawPath":"sec/raw/e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92.bin","sha256":"e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92"},"layers":{"businessProfile":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"operatingKpis":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"managementExplanations":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"materialEvents":{"status":"evidence_available","evidence":[{"id":"1ccad94fabdbc12f132d0abac80344bb333b1ea80e96e9243e06fae02688ce22","quote":"A Participant who has 5 Years of Service for vesting purposes after the effective date of either a Participation Agreement under this plan, a Participation Agreement under the Grandfathered SERP, or a written deferred compensation agreement previously entered into between the Participant and the Company (a \"Deferred Compensation Agreement\"), or who has reached age 65 before Retiring, will be entitled to a benefit computed under this Section, unless the benefit is forfeited under Article 6. For purposes of this Article 5 and Article 7, the terms \"Retiring\" or \"Retire\" shall include an Employee's Termination of Employment.","context":"5.1 Retirement Benefits.","section":"","block":13,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001628280-26-012614","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0000110471","url":"https://www.sec.gov/Archives/edgar/data/110471/000162828026012614/a2025-q4ex1013thirdamendme.htm","rawPath":"sec/raw/e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92.bin","sha256":"e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92"}}],"omittedEvidenceCount":0},"riskFactors":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"segmentIntelligence":{"status":"evidence_available","evidence":[{"id":"2b3ba77fcf6461921fda15e59dd1bfe2b44d50d3f050d414dfc4f3ace6a16f0f","quote":"(i) Age of Commencement. If the Participant begins receiving a benefit between age 60 and 65, the actuarially equivalent reduction in the benefit amount shall be .1666% (1/6 of 1%) for each month between the date the benefit begins and the first day of the month following the month in which the Participant would attain age 65. If the Participant begins receiving benefits between age 55 and 60, the actuarially equivalent reduction shall be an additional .333% (1/3 of 1%) for each month between the date the benefit begins and the first day of the month following the month in which the Participant would attain age 60. For avoidance of doubt, and consistent with Section 7.3, if the Participant (other than an Inactive Participant) begins receiving a benefit at least 12 months after attaining age 65 (not including any applicable Specified Employee postponement), the Participant's Annual Benefit will be adjusted for late payment using the applicable interest rate specified in Section 2.5, subject to any minimum or maximum rates determined annually based on the appropriate segment rate(s) determined by the Administrator for the Participant.","context":"(b) Actuarial Adjustments. If payment to the Participant commences prior to or after the date the Participant attains age 65 or in a form other than a single life annuity, the Participant's Annual Benefit shall be adjusted in accordance with the following provisions.","section":"","block":25,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001628280-26-012614","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0000110471","url":"https://www.sec.gov/Archives/edgar/data/110471/000162828026012614/a2025-q4ex1013thirdamendme.htm","rawPath":"sec/raw/e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92.bin","sha256":"e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92"}},{"id":"2cf7edb3ee1451b56cf7d0e99518c43bd03e9241dead3fe2b878daa70ecd8aac","quote":"(ii) Form. All forms of payment will be actuarially equivalent to the benefit payable as a single life annuity. If payment is made in a form other than a single life annuity, the amount of the benefit shall be adjusted based on the actuarial factors determined under Section 2.5.","context":"(i) Age of Commencement. If the Participant begins receiving a benefit between age 60 and 65, the actuarially equivalent reduction in the benefit amount shall be .1666% (1/6 of 1%) for each month between the date the benefit begins and the first day of the month following the month in which the Participant would attain age 65. If the Participant begins receiving benefits between age 55 and 60, the actuarially equivalent reduction shall be an additional .333% (1/3 of 1%) for each month between the date the benefit begins and the first day of the month following the month in which the Participant would attain age 60. For avoidance of doubt, and consistent with Section 7.3, if the Participant (other than an Inactive Participant) begins receiving a benefit at least 12 months after attaining age 65 (not including any applicable Specified Employee postponement), the Participant's Annual Benefit will be adjusted for late payment using the applicable interest rate specified in Section 2.5, subject to any minimum or maximum rates determined annually based on the appropriate segment rate(s) determined by the Administrator for the Participant.","section":"","block":26,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001628280-26-012614","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0000110471","url":"https://www.sec.gov/Archives/edgar/data/110471/000162828026012614/a2025-q4ex1013thirdamendme.htm","rawPath":"sec/raw/e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92.bin","sha256":"e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92"}}],"omittedEvidenceCount":0}},"warnings":[]},{"version":1,"source":{"accession":"0001628280-26-012614","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0000110471","url":"https://www.sec.gov/Archives/edgar/data/110471/000162828026012614/a2025-q4ex1014wolverineemp.htm","rawPath":"sec/raw/5afe8ceace42544a632e584a8d8a737ec6544099734d85034942c3a00998d144.bin","sha256":"5afe8ceace42544a632e584a8d8a737ec6544099734d85034942c3a00998d144"},"layers":{"businessProfile":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"operatingKpis":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"managementExplanations":{"status":"evidence_available","evidence":[{"id":"018f5ed1f20676b0fcbe5bd7743f55c8f8fc03b753b4ef845f1eeb5a5005b5cc","quote":"For purposes of Code Section 411(b)(1)(H), the actuarial increase will be treated as an adjustment attributable to the delay in payment of benefits after the attainment of normal retirement age. Accordingly, to the extent permitted under Code Section 411(b)(1)(H), the actuarial increase required under Code Section 401(a)(9)(C)(iii) may reduce the benefit accrual otherwise required under Code Section 411(b)(1)(H)(i), except that the rules on suspension of benefits are not applicable.","context":"(iii) Application of Actuarial Increase Rules. The actuarial increase is generally the same as, and not in addition to, the actuarial increase required for that same period under Code Section 411 to reflect a delay in payments after the Participant's Normal Retirement Date.","section":"","block":833,"table":null,"attribution":"management","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001628280-26-012614","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0000110471","url":"https://www.sec.gov/Archives/edgar/data/110471/000162828026012614/a2025-q4ex1014wolverineemp.htm","rawPath":"sec/raw/5afe8ceace42544a632e584a8d8a737ec6544099734d85034942c3a00998d144.bin","sha256":"5afe8ceace42544a632e584a8d8a737ec6544099734d85034942c3a00998d144"}},{"id":"fb876dfe00f987f4b78b93d17c4d9c8b30fa3455a8fd8ea677eda94c0c95b89a","quote":"(ii) Individually Designed. The date the Internal Revenue Service notifies the Employer that the plan is an individually designed plan due to the nature and extent of amendments by the Employer; or","context":"(i) Type of Plan. The date the Employer amends the plan to incorporate a type of plan not permitted under the pre-approved plan program, as described in Revenue Procedure 2017-41 or any superseding guidance;","section":"","block":1085,"table":null,"attribution":"management","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001628280-26-012614","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0000110471","url":"https://www.sec.gov/Archives/edgar/data/110471/000162828026012614/a2025-q4ex1014wolverineemp.htm","rawPath":"sec/raw/5afe8ceace42544a632e584a8d8a737ec6544099734d85034942c3a00998d144.bin","sha256":"5afe8ceace42544a632e584a8d8a737ec6544099734d85034942c3a00998d144"}},{"id":"42c046e71e85c5e5289155fb97c4b0225e80a779036a778e90cc58ad125f246b","quote":"(B) Benefit Decrease. If benefits under this plan had been reduced during the three-year period ending at termination by amendment or due to the form of payment, the lowest payment received during that period shall be considered as the benefit that was being received three years before termination.","context":"(A) Benefit. For this purpose, the benefit shall be the smaller of the benefit that was being received or the benefit that would have been received had the Participant retired based on the least benefit in effect during the five-year period ending at termination.","section":"","block":1114,"table":null,"attribution":"management","interpretation":"source_excerpt_not_in