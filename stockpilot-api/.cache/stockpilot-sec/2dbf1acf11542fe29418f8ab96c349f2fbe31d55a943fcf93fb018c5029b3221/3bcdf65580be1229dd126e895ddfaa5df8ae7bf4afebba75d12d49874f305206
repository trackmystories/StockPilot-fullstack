8">)&#160;</td><td style="vertical-align: bottom;">&#160;</td><td style="text-align: left; border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(0, 0, 0); vertical-align: bottom; width: 1%;" title="5. Debt  - E18">&#160;</td><td style="text-align: right; border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(0, 0, 0); vertical-align: bottom; width: 11%;">(<ix:nonFraction contextRef="c3" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtCurrent" scale="3" unitRef="usd" id="ixv-5610">330</ix:nonFraction></td><td style="text-align: left; border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(0, 0, 0); vertical-align: bottom; width: 1%;" title="5. Debt  - E18">)&#160;</td></tr><tr style="background-color: rgb(174, 237, 183);"><td style="text-align: right; vertical-align: bottom;">Long-term portion</td><td style="vertical-align: bottom;">&#160;</td><td style="text-align: left; border-width: medium medium 3px; border-style: none none double; border-color: currentcolor currentcolor rgb(0, 0, 0); vertical-align: bottom; width: 1%;" title="5. Debt  - C19">$</td><td style="text-align: right; border-width: medium medium 3px; border-style: none none double; border-color: currentcolor currentcolor rgb(0, 0, 0); vertical-align: bottom; width: 11%;"><ix:nonFraction contextRef="c2" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtNoncurrent" scale="3" unitRef="usd" id="ixv-5611">189,364</ix:nonFraction></td><td style="text-align: left; border-width: medium medium 3px; border-style: none none double; border-color: currentcolor currentcolor rgb(0, 0, 0); vertical-align: bottom; width: 1%;" title="5. Debt  - C19">&#160;</td><td style="vertical-align: bottom;">&#160;</td><td style="text-align: left; border-width: medium medium 3px; border-style: none none double; border-color: currentcolor currentcolor rgb(0, 0, 0); vertical-align: bottom; width: 1%;" title="5. Debt  - E19">$</td><td style="text-align: right; border-width: medium medium 3px; border-style: none none double; border-color: currentcolor currentcolor rgb(0, 0, 0); vertical-align: bottom; width: 11%;"><ix:nonFraction contextRef="c3" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtNoncurrent" scale="3" unitRef="usd" id="ixv-5612">221,900</ix:nonFraction></td><td style="text-align: left; border-width: medium medium 3px; border-style: none none double; border-color: currentcolor currentcolor rgb(0, 0, 0); vertical-align: bottom; width: 1%;" title="5. Debt  - E19">&#160;</td></tr></table></ix:nonNumeric></ix:nonNumeric><div style="font-size: 10pt;">&#160;</div><div style="font-size: 10pt;">&#160;
