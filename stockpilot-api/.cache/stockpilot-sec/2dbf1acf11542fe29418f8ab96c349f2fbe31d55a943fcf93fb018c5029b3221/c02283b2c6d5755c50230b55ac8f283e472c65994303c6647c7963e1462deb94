b4a122ee356352031b9bf4baa07c0afdb56e23ec8c31776a3884ec8c429cd84c{"version":1,"source":{"accession":"0001376474-26-000319","form":"20-F","filedAt":"2026-04-29","reportDate":"2025-12-31","cik":"0001997403","url":"https://www.sec.gov/Archives/edgar/data/1997403/000137647426000319/zt_20f.htm","rawPath":"sec/raw/295395c6ca709d99c538e0f784a5448fe4c384536ae04b0309c9fca7f0ab606e.bin","sha256":"295395c6ca709d99c538e0f784a5448fe4c384536ae04b0309c9fca7f0ab606e"},"layers":{"businessProfile":{"status":"evidence_available","evidence":[{"id":"238a80dc8de2b23a2aba232f23af79b944521073d09910824d1be77bb62ec52d","quote":"ZenaTech, Inc. is a technology solutions company that specializes in mission-critical cloud-based software applications integrated with smart hardware to deliver innovative solutions across diverse industries. Prior to January 1, 2025, the Company operated in the software business as it incurred expenses developing its drone business. However, in 2025, the Company began generating revenues in the drone services business through acquisitions. Hence, the Company now operates in two segments: (i) Enterprise Software-as-a-Service (“SaaS”) software development technology, sales, and distribution and (ii) drone development, manufacturing, sales, distribution and services. ZenaTech, Inc. is the parent holding company that operates through wholly owned subsidiary companies as described below.","context":"General Corporate Information","section":"Item 4. Information on the Company","block":437,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001376474-26-000319","form":"20-F","filedAt":"2026-04-29","reportDate":"2025-12-31","cik":"0001997403","url":"https://www.sec.gov/Archives/edgar/data/1997403/000137647426000319/zt_20f.htm","rawPath":"sec/raw/295395c6ca709d99c538e0f784a5448fe4c384536ae04b0309c9fca7f0ab606e.bin","sha256":"295395c6ca709d99c538e0f784a5448fe4c384536ae04b0309c9fca7f0ab606e"}},{"id":"42cce19303b4a434463d47b8b20346f9a8a7aae612dbf5e06ac85054095f44c0","quote":"The Company was incorporated by Articles of Incorporation in the State of Illinois, USA, on August 31, 2017, under the name ZenaPay, Inc. The Company was a wholly owned subsidiary of Epazz, Inc. (\"Epazz\") until November 30, 2018, when it was restructured as a separate entity by way of a stock dividend to Epazz shareholders. On December 14, 2018, the Company was domiciled in British Columbia, Canada through Articles of Continuance pursuant to the provisions of the Business Corporation Act (British Columbia). The name of the Company was changed to ZenaDrone, Inc. on August 11, 2020, and subsequently to ZenaTech, Inc. on October 5, 2020, to better reflect the business of the Company and its corporate organization.","context":"ZenaTech, Inc. is a technology solutions company that specializes in mission-critical cloud-based software applications integrated with smart hardware to deliver innovative solutions across diverse industries. Prior to January 1, 2025, the Company operated in the software business as it incurred expenses developing its drone business. However, in 2025, the Company began generating revenues in the drone services business through acquisitions. Hence, the Company now operates in two segments: (i) Enterprise Software-as-a-Service (“SaaS”) software development technology, sales, and distribution and (ii) drone development, manufacturing, sales, distribution and services. ZenaTech, Inc. is the parent holding company that operates through wholly owned subsidiary companies as described below.","section":"Item 4. Information on the Company","block":438,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001376474-26-000319","form":"20-F","filedAt":"2026-04-29","reportDate":"2025-12-31","cik":"0001997403","url":"https://www.sec.gov/Archives/edgar/data/1997403/000137647426000319/zt_20f.htm","rawPath":"