2888" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-16456">5,000,000,000</ix:nonFraction> shares of Class A common stock with par value of $<ix:nonFraction name="us-gaap:CommonStockParOrStatedValuePerShare" contextRef="cref_1534559523" unitRef="uref_1333963553" scale="0" decimals="2" format="ixt:num-dot-decimal" id="ixv-16457">0.01</ix:nonFraction> each. As of December 31, 2025, there were <ix:nonFraction name="us-gaap:CommonStockSharesIssued" contextRef="cref_1534559523" unitRef="uref_1604012888" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-16458"><ix:nonFraction name="us-gaap:CommonStockSharesOutstanding" contextRef="cref_1534559523" unitRef="uref_1604012888" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-16459">346,548,153</ix:nonFraction></ix:nonFraction> shares of Class A Common Stock issued and outstanding.</span> </p><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p><p style="text-align: justify; font: 10pt Times New Roman, Times, Serif; margin: 0pt"> <span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span style="font-weight: bold;"><i>Class B Common Stock</i></span>&#8212; The Company is authorized to issue <ix:nonFraction name="us-gaap:CommonStockSharesAuthorized" contextRef="cref_624133250" unitRef="uref_1604012888" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-16460">500,000,000</ix:nonFraction> shares of Class B common stock with par value of $<ix:nonFraction name="us-gaap:CommonStockParOrStatedValuePerShare" contextRef="cref_624133250" unitRef="uref_1333963553" scale="0" decimals="2" format="ixt:num-dot-decimal" id="ixv-16461">0.01</ix:nonFraction> each. As of December 31, 2025, there were <ix:nonFraction name="us-gaap:CommonStockSharesIssued" contextRef="cref_624133250" unitRef="uref_1604012888" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-16462"><ix:nonFraction name="us-gaap:CommonStockSharesOutstanding" contextRef="cref_624133250" unitRef="uref_1604012888" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-16463">304,842,759</ix:nonFraction></ix:nonFraction> shares of Class B Common Stock issued and outstanding.</span> </p><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><i>Stock Options</i></span></p><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">&#160;</span></p><p style="text-align: justify; font: 10pt Times New Roman, Times, Serif; margin: 0pt"> On December 8, 2025, the Company entered into two employment agreements, pursuant to which the Company granted <ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriod" contextRef="cref_263333094" unitRef="uref_1604012888" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-16464">13,120,888</ix:nonFraction> options to employees with vesting periods of <ix:nonNumeric name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod1" contextRef="cref_940068555" format="ixt-sec:duryear" id="ixv-16465">4</ix:nonNumeric> or <ix:nonNumeric name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod1" contextRef="cref_1220163935" format="ixt-sec:duryear" id="ixv-16466">5</ix:nonNumeric> years, respectively and exercise price of $<ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsVestedAndExpectedToVestOutstandingWeightedAverageExercisePrice" contextRef="cref_1374054646" unitRef="uref_1333963553" scale="0" decimals="2" format="ixt:num-dot-decimal" id="ixv-16467">14.43</ix:nonFract