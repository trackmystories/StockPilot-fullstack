es New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_dae05e84-692c-4cff-aa62-b2d99bcabfeb" contextRef="C_d67bc717-c65d-49ab-a2a7-11d8ad76bae3" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" unitRef="U_pure" scale="-2" decimals="4" format="ixt:num-dot-decimal">0.00</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">% to </span><span style="font-size:10pt;font-family:Times New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_957b5502-8294-4fbe-8551-91f4e4507c2f" contextRef="C_b1f5c1a9-778c-406c-925d-b35484b68e40" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" unitRef="U_pure" scale="-2" decimals="5" format="ixt:num-dot-decimal">0.250</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">% (based upon the Company&#8217;s guaranteed senior-unsecured long-term debt rating). In addition, the Borrowers will pay a commitment fee in an amount equal to </span><span style="font-size:10pt;font-family:Times New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_70485733-6076-47a9-9e22-e584f5001c10" contextRef="C_fa77c2e3-f8ca-4392-96eb-1dcfe3784570" name="us-gaap:LineOfCreditFacilityUnusedCapacityCommitmentFeePercentage" unitRef="U_pure" scale="-2" decimals="5" format="ixt:num-dot-decimal">0.055</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">% to </span><span style="font-size:10pt;font-family:Times New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_29462a10-298e-454c-8bd7-fe560c2b9d70" contextRef="C_8d813981-c1d7-4a13-a416-a5b77