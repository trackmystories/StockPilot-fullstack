7bfc7f50a4d24e4561b0b46391819adee65acc9f1c96a390eb7b61b9b1ae0f5c[{"version":1,"source":{"accession":"0001493152-26-032621","form":"8-K","filedAt":"2026-07-09","reportDate":"2026-07-09","cik":"0001641631","url":"https://www.sec.gov/Archives/edgar/data/1641631/000149315226032621/form8-k.htm","rawPath":"sec/raw/965b8227118a4ec7660529187350d6a79849411ddf953ec22def0d13521e8dfe.bin","sha256":"965b8227118a4ec7660529187350d6a79849411ddf953ec22def0d13521e8dfe"},"layers":{"businessProfile":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"operatingKpis":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"managementExplanations":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"materialEvents":{"status":"evidence_available","evidence":[{"id":"c4457c4a9d93205d3c14fb17ab5ccbd31f0e769944b469a48b8030fb88f037ea","quote":"Beyond Air, Inc., a Delaware corporation (the “Company”), approved a reverse stock split of the Company’s issued and outstanding shares of common stock (“Common Stock”), at a ratio of 1-for-20 (the “Reverse Stock Split”). The Reverse Stock Split was duly approved in a special meeting of the stockholders held on June 18, 2026. On July 9, 2026, the Company filed with the Secretary of State of the State of Delaware the Fourth Certificate of Amendment to its Amended and Restated Certificate of Incorporation (the “Certificate of Amendment”) to effect the Reverse Stock Split. The Reverse Stock Split will become effective as of 12:01 a.m., Eastern Time, on July 13, 2026, and the Company’s Common Stock will begin trading on the Nasdaq Stock Market on a split-adjusted basis when the market opens on July 13, 2026.","context":"Item 5.03 Amendments to Articles of Incorporation or Bylaws; Change in Fiscal Year.","section":"Item 5.03 Amendments to Articles of Incorporation or Bylaws; Change in Fiscal Year.","block":27,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001493152-26-032621","form":"8-K","filedAt":"2026-07-09","reportDate":"2026-07-09","cik":"0001641631","url":"https://www.sec.gov/Archives/edgar/data/1641631/000149315226032621/form8-k.htm","rawPath":"sec/raw/965b8227118a4ec7660529187350d6a79849411ddf953ec22def0d13521e8dfe.bin","sha256":"965b8227118a4ec7660529187350d6a79849411ddf953ec22def0d13521e8dfe"}},{"id":"4dd583f3dd20ba570cdb8846e8866cd79469cc74b766e25467d1c46ef65e4607","quote":"On the Effective Date, the total number of shares of Common Stock held by each stockholder of the Company will be exchanged for the number of shares of Common Stock equal to the number of issued and outstanding shares of Common Stock held by each such stockholder immediately prior to the Reverse Stock Split, divided by twenty (20), with such resulting number of shares rounded up to the nearest whole share. As a result, no fractional shares will be issued in connection with the Reverse Stock Split and no cash or other consideration shall be paid in connection with any fractional shares that would otherwise have resulted from the Reverse Stock Split. The Company does not intend to round up fractional shares at the beneficial level and will instead round any such fractional shares up at the participant level. Also on the Effective Date, all equity awards outstanding immediately prior to the Reverse Stock Split will be adjusted to reflect the Reverse Stock Split.","context":"Split Adjustment; Treatment of Fractional Shares","section":"Item 5.03 Amendments to Articles of Incorporation or Bylaws; Change in Fiscal Year.","block":34,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001493152-26-032621","form":"8-K","filedAt":"2026-07-09","reportDate":"2026-07-09","cik":"0001641631","url":"https://www.sec.gov/Archives/edgar/data/1641631/000149315226032621/form8-k.htm","rawPath":"sec/raw/965b8227118a4ec7660529187350d6a79849411ddf953ec22def0d13521e8dfe.bi