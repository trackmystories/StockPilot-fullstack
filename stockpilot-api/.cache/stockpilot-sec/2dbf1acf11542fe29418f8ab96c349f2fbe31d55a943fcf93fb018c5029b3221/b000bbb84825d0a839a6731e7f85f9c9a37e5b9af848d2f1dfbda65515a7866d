an><i style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;font-weight:normal;">Long-term Debt and Credit Facilities</i><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">, with MidCap Financial Trust as Agent and Lender, providing a </span><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">$<ix:nonFraction unitRef="Unit_Standard_USD_q4HVJlM7Q0StRndL3BeWvQ" contextRef="As_Of_7_29_2025_us-gaap_DebtInstrumentAxis_xbp_AblCreditAgreementMember_rDNVXKUNkU2W3M1uFQOj-w" decimals="-6" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="6" id="Narr_sev6WCbU-Ea0ZJSyIS0-sQ">150</ix:nonFraction></span><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;"> million revolving credit facility, secured by ABL Priority Collateral (as defined therein), with terms including interest at SOFR plus Applicable Margin (</span><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;"><ix:nonFraction unitRef="Unit_Standard_pure_x-DraIrURkqybk-ATSvGbg" contextRef="Duration_7_29_2025_To_7_29_2025_srt_RangeAxis_srt_MinimumMember_us-gaap_DebtInstrumentAxis_xbp_AblCreditAgreementMember_sUqHPLU0ZkWNSL51VZlBJQ" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" scale="-2" id="Narr_eFYUr3WDp0KDesuRyo2KbA">3.75</ix:nonFraction>%</span><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">-</span><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;"><ix:nonFraction unitRef="Unit_Standard_pure_x-DraIrURkqybk-ATSvGbg" contextRef="Duration_7_29_2025_To_7_29_2025_srt_RangeAxis_srt_MaximumMember_us-gaap_DebtInstrumentAxis_xbp_AblCreditAgreementMember_Ng7rw