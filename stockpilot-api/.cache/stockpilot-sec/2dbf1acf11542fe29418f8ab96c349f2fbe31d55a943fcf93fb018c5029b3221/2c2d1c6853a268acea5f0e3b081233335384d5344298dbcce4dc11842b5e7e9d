        December 31, 2025, approximately <ix:nonFraction name="yorw:PercentageOfEmployeesUnderUnionContract" id="Fact_0ed64071eab84fbbbfcc5d0876f9b2e3" contextRef="c20251231" unitRef="U006" decimals="2" scale="-2" format="ixt:num-dot-decimal">28</ix:nonFraction>%
