      <ix:continuation id="Text_b8a19f2e86fd48d1b46bbbb249cf771218" continuedAt="Text_b8a19f2e86fd48d1b46bbbb249cf771219">
<div style="text-align: justify; font-family: 'Times New Roman', Times, serif; font-size: 10pt;">On January 29, 2024, the Board accelerated the vesting period for restricted stock granted in 2022 and 2023 to <ix:nonFraction name="yorw:ShareBasedCompensationArrangementByShareBasedPaymentAwardNumberOfRetiringOfficersReceivingAcceleratedVestingPeriod" id="Fact_57695292d96a4d0d987770ea1b4f88be" contextRef="c20240129to20240129" unitRef="U011" decimals="INF" scale="0" format="ixt-sec:numwordsen">one</ix:nonFraction> retiring officer from <ix:nonNumeric name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod1" id="Fact_e98afdf8b2624069857a01d84ba3da26" contextRef="c20250101to20251231_AwardDateAxis_GrantedIn2022And2023Member_AwardTypeAxis_RestrictedStockMember_GranteeStatusAxis_OfficerRetiringIn2024Member_PlanNameAxis_YorkWaterCompanyLongTermIncentivePlanMember" format="ixt-sec:durwordsen">three years</ix:nonNumeric> to that officer&#8217;s 2024
        retirement date, which has been fully recognized as of December 31, 2024.</div>
</ix:continuation>
      <ix:continuation id="Text_b8a19f2e86fd48d1b46bbbb249cf771219" continuedAt="Text_b8a19f2e86fd48d1b46bbbb249cf771220">
