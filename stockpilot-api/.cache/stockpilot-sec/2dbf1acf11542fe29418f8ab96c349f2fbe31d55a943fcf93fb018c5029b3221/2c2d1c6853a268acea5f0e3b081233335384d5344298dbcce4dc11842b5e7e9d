    <ix:nonNumeric name="us-gaap:OrganizationConsolidationBasisOfPresentationBusinessDescriptionAndAccountingPoliciesTextBlock" id="Text_8b45ca5e3d364abebc271dd346bf2ba8" contextRef="c20250101to20251231" escape="true" continuedAt="Text_453223bc921f4c5f8bd8882781bcf7081">
<div style="text-align: left; font-family: 'Times New Roman', Times, serif; font-size: 10pt; font-weight: bold;">1.&#160; Significant Accounting Policies</div>
</ix:nonNumeric>
    <ix:continuation id="Text_453223bc921f4c5f8bd8882781bcf7081" continuedAt="Text_453223bc921f4c5f8bd8882781bcf7082">
<div><br/>
