01de908bb57003eeb3b7a98e3e8abb6017e9ba4c5a5d67dae19146bbed5b6ac3{"version":1,"source":{"accession":"0001877787-26-000030","form":"6-K","filedAt":"2026-07-23","reportDate":"2026-06-30","cik":"0001877787","url":"https://www.sec.gov/Archives/edgar/data/1877787/000187778726000030/pressreleaserevenuesq22026.htm","rawPath":"sec/raw/2ddcbf04a45e7e958e9d8a49433ec1880d4964b84432db9452ac1b2c69db26ae.bin","sha256":"2ddcbf04a45e7e958e9d8a49433ec1880d4964b84432db9452ac1b2c69db26ae"},"layers":{"businessProfile":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"operatingKpis":{"status":"evidence_available","evidence":[{"id":"771e558beae3044329c19be93155ce02f09ddb5534696c5c99e2084b537df5c0","quote":"Founded in 1910 in Trivero, Italy, the Ermenegildo Zegna Group (NYSE:ZGN) is a global luxury company with a leading position in the high-end menswear business. Through its three complementary brands, the Group reaches a wide range of communities and market segments across the high-end fashion industry, from ZEGNA’s timeless luxury to the modern tailoring of Thom Browne, to seductive elegance with TOM FORD FASHION. The Ermenegildo Zegna Group is internationally recognized for its unique Filiera, owned and controlled by the Group, which is made up of the finest Italian textile producers fully integrated with unique luxury manufacturing capabilities, to ensure superior excellence, quality and innovation capacity. The Ermenegildo Zegna Group has more than 7,200 employees and recorded revenues of €1.92 billion in 2025.","context":"About Ermenegildo Zegna Group","section":"","block":72,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001877787-26-000030","form":"6-K","filedAt":"2026-07-23","reportDate":"2026-06-30","cik":"0001877787","url":"https://www.sec.gov/Archives/edgar/data/1877787/000187778726000030/pressreleaserevenuesq22026.htm","rawPath":"sec/raw/2ddcbf04a45e7e958e9d8a49433ec1880d4964b84432db9452ac1b2c69db26ae.bin","sha256":"2ddcbf04a45e7e958e9d8a49433ec1880d4964b84432db9452ac1b2c69db26ae"}}],"omittedEvidenceCount":0},"managementExplanations":{"status":"evidence_available","evidence":[{"id":"7d0e70e0bf379c5c417ec47f2a68aa31a36bda95f2aaa39776cdd7eb24cedf4a","quote":"ZEGNA DTC revenues were €301.0 million, +18.6% YoY (+18.4% organic), in sequential acceleration driven by double-digit organic growth in all the geographic areas, led by the Americas. GCR reported a sequential improvement in the quarter, and performance in the Rest of APAC continued to strengthen. In EMEA, Europe continued to perform strongly, while Middle East recorded a positive performance during the quarter despite the initial impact of the conflict in the region. At June 30, 2026, ZEGNA counted 279 directly operated stores (DOS), stable compared to the first quarter.","context":"In Q2 2026, DTC revenues were €410.9 million, compared to €352.9 million in Q2 2025, +16.4% YoY (+17.3% organic), with double-digit organic growth across all brands.","section":"","block":32,"table":null,"attribution":"management","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001877787-26-000030","form":"6-K","filedAt":"2026-07-23","reportDate":"2026-06-30","cik":"0001877787","url":"https://www.sec.gov/Archives/edgar/data/1877787/000187778726000030/pressreleaserevenuesq22026.htm","rawPath":"sec/raw/2ddcbf04a45e7e958e9d8a49433ec1880d4964b84432db9452ac1b2c69db26ae.bin","sha256":"2ddcbf04a45e7e958e9d8a49433ec1880d4964b84432db9452ac1b2c69db26ae"}},{"id":"0337e176f5870aa552715ae220b866f6f66436a924c4400fe20b797f176ba2df","quote":"TOM FORD FASHION DTC revenues were €58.1 million, +9.9% YoY (+13.1% organic), driven by continued growth in the Americas and Rest of APAC, supported by the strong reception of the Spring/Summer collection. At June 30, 2026, TOM FORD FASHION had 67 DOS, with 1 net closure in the second quarter of a boutique in China.","context":"Thom Browne DTC revenues were €51.8 million, +11.8% YoY (+16.0% organic), with a strong momentum driven by the Americas, Korea and Japan. At June 30, 2026, Thom Browne had 128 DOS, with 3 net openings in the second quarter including Chicago and Vancouver.","section":"","block":34,"table":null,"attribution":"management","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001877787-26-000030","form":"6-K","filedAt":"2026-07-23","reportDate":"2026-06-30","cik":"0001877787","url":"https://www.sec.gov/Archives/edgar/data/1877787/000187778726000030/pressreleaserevenuesq22026.htm","rawPath":"sec/raw/2ddcbf04a45e7e958e9d8a49433ec1880d4964b84432db9452ac1b2c69db26ae.bin","sha256":"2ddcbf04a45e7e958e9d8a49433ec1880d4964b84432db9452ac1b2c69db26ae"}},{"id":"fd881a47cff295d1d47ca6d7e2851cb43ae69fa97cf1ac69a63bb49a4733f77d","quote":"Rest of APAC (12% of the Group’s H1 revenues) recorded revenues of €62.1 million in Q2, +11.5% YoY (+19.3% organic), driven by solid growth in all markets, especially in Korea and Japan.","context":"GCR (24% of the Group’s H1 revenues) recorded revenues of €112.0 million in Q2, +12.2% YoY (+8.6% organic), with an acceleration in the performance versus Q1.","section":"","block":51,"table":null,"attribution":"management","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001877787-26-000030","form":"6-K","filedAt":"2026-07-23","reportDate":"2026-06-30","cik":"0001877787","url":"https://www.sec.gov/Archives/edgar/data/1877787/000187778726000030/pressreleaserevenuesq22026.htm","rawPath":"sec/raw/2ddcbf04a45e7e958e9d8a49433ec1880d4964b84432db9452ac1b2c69db26ae.bin","sha256":"2ddcbf04a45e7e958e9d8a49433ec1880d4964b84432db9452ac1b2c69db26ae"}}],"omittedEvidenceCount":0},"materialEvents":{"status":"evidence_available","evidence":[{"id":"b4b20cb54abf8cc394065aa3902b616b371dab4de1c3fa511d0908762c13c4a2","quote":"(2)Acquisitions and disposals – Revenues generated by businesses and operations acquired in the current ye