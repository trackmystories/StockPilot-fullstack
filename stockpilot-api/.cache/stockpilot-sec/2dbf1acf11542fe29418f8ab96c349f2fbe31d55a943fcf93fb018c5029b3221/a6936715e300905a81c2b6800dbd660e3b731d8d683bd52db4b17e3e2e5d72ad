0b9f0a599c91ab8b7a6c46056cc7d0ca2425e6aa4dc40f9b89a1466e14be8a8d{"version":1,"source":{"accession":"0001725160-26-000061","form":"8-K","filedAt":"2026-08-06","reportDate":"2026-08-06","cik":"0001725160","url":"https://www.sec.gov/Archives/edgar/data/1725160/000172516026000061/zntlq22026pressrelease.htm","rawPath":"sec/raw/bd6ffcdc62760fff5b7a27fc2a771f6e1912725404dbac1643132b95f55ea211.bin","sha256":"bd6ffcdc62760fff5b7a27fc2a771f6e1912725404dbac1643132b95f55ea211"},"layers":{"businessProfile":{"status":"evidence_available","evidence":[{"id":"862bcb89ced78334e34fc02921ff6dd8ec40065c282bfc08925a0cd2d7301554","quote":"•Regulatory Update: Met with the FDA in a Type D meeting regarding the Company’s accelerated approval strategy, including dose. The FDA had no objection to the continued study of the selected monotherapy dose of azenosertib at the 400mg once daily on a 5-days-on, 2-days-off schedule (400mg QD 5:2) in patients with Cyclin E1-positive PROC, selected based on a pre-specified interim analysis from DENALI Part 2a. The FDA acknowledged the DENALI Part 2 study population, including the 2c cohort, has the potential to support an accelerated approval pathway, subject to the strength of the data and the landscape of approved agents at the time of regulatory action.","context":"Business Updates","section":"Business Updates","block":11,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001725160-26-000061","form":"8-K","filedAt":"2026-08-06","reportDate":"2026-08-06","cik":"0001725160","url":"https://www.sec.gov/Archives/edgar/data/1725160/000172516026000061/zntlq22026pressrelease.htm","rawPath":"sec/raw/bd6ffcdc62760fff5b7a27fc2a771f6e1912725404dbac1643132b95f55ea211.bin","sha256":"bd6ffcdc62760fff5b7a27fc2a771f6e1912725404dbac1643132b95f55ea211"}},{"id":"ddd7038b2e5cb86af0baa40e70df2ed86173b0acb9adce97fd6effdbd57fdd2a","quote":"•DENALI Part 2 Enrollment and Integrated Topline Readout: Enrollment in DENALI Parts 2a and 2b is complete. Earlier this year, the Company expanded DENALI Part 2 to broaden the overall study population and enrich patients previously treated with a taxane-containing regimen for PROC, aligning the study population with the evolving treatment landscape of approved agents. DENALI Part 2c is currently enrolling. The integrated dataset of DENALI Parts 2a, 2b, and 2c is designed to support accelerated approval in the Cyclin E1 biomarker-selected patient","context":"•Regulatory Update: Met with the FDA in a Type D meeting regarding the Company’s accelerated approval strategy, including dose. The FDA had no objection to the continued study of the selected monotherapy dose of azenosertib at the 400mg once daily on a 5-days-on, 2-days-off schedule (400mg QD 5:2) in patients with Cyclin E1-positive PROC, selected based on a pre-specified interim analysis from DENALI Part 2a. The FDA acknowledged the DENALI Part 2 study population, including the 2c cohort, has the potential to support an accelerated approval pathway, subject to the strength of the data and the landscape of approved agents at the time of regulatory action.","section":"Business Updates","block":12,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001725160-26-000061","form":"8-K","filedAt":"2026-08-06","reportDate":"2026-08-06","cik":"0001725160","url":"https://www.sec.gov/Archives/edgar/data/1725160/000172516026000061/zntlq22026pressrelease.htm","rawPath":"sec/raw/bd6ffcdc62760fff5b7a27fc2a771f6e1912725404dbac1643132b95f55ea211.bin","sha256":"bd6ffcdc62760fff5b7a27fc2a771f6e1912725404dbac1643132b95f55ea211"}},{"id":"4316e3a7971c35fba465758c0251f12a2a444538493e6e2fb7a6e9c50600ecd9","quote":"population, subject to regulatory review. The Company expects to provide a topline readout in 1H 2027 to allow for data maturation post full enrollment.","context":"•DENALI Part 2 Enrollment and Integrated Topline Readout: Enrollment in DENALI Parts 2a and 2b is complete. Earlier this year, the Company expanded DENALI Part 2 to broaden the overall study population and enrich patients previously treated with a taxane-containing regimen for PROC, aligning the study population with the evolving treatment landscape of approved agents. DENALI Part 2c is currently enrolling. The integrated dataset of DENALI Parts 2a, 2b, and 2c is designed to support accelerated approval in the Cyclin E1 biomarker-selected patient","section":"Business Updates","block":13,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001725160-26-000061","form":"8-K","filedAt":"2026-08-06","reportDate":"2026-08-06","cik":"0001725160","url":"https://www.sec.gov/Archives/edgar/data/1725160/000172516026000061/zntlq22026pressrelease.htm","rawPath":"sec/raw/bd6ffcdc62760fff5b7a27fc2a771f6e1912725404dbac1643132b95f55ea211.bin","sha256":"bd6ffcdc62760fff5b7a27fc2a771f6e1912725404dbac1643132b95f55ea211"}},{"id":"38131fba20f5693f7c803f07192de5f22168703906d082ca2ddc489f5da74cb3","quote":"•ASPENOVA Phase 3 First Patient Dosed: In May 2026, announced the first patient was dosed in the Phase 3 ASPENOVA confirmatory trial designed to satisfy FDA requirements for U.S. full approval and to support approval in major ex-U.S. markets. The trial is currently enrolling.","context":"population, subject to regulatory review. The Company expects to provide a topline readout in 1H 2027 to allow for data maturation post full enrollment.","section":"Business Updates","block":14,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001725160-26-000061","form":"8-K","filedAt":"2026-08-06","reportDate":"2026-08-06","cik":"0001725160","url":"https://www.sec.gov/Archives/edgar/data/1725160/000172516026000061/zntlq22026pressrelease.htm","rawPath":"sec/raw/bd6ffcdc62760fff5b7a