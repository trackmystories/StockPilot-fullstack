O Performance Award mentioned below, the expense is expected to be recognized over a weighted average period of </div></div><ix:nonNumeric name="us-gaap:EmployeeServiceShareBasedCompensationNonvestedAwardsTotalCompensationCostNotYetRecognizedPeriodForRecognition1" contextRef="P01_01_2025To12_31_2025_TwoThousandTwentyFivePlanMemberusgaapPlanNameAxis" format="ixt-sec:duryear" id="ixv-42263">3.72</ix:nonNumeric> <div style="letter-spacing: 0px; top: 0px;display:inline;"><div style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; letter-spacing: 0px; top: 0px;display:inline;">years and may be adjusted for future changes in forfeitures. </div></div></div> <div style="font-size:6pt; margin-top:0pt; margin-bottom:0pt">&#160;</div> <div style="margin-top: 0px; margin-bottom: 0px; font-size: 8pt;">&#160;</div> <div style="margin-top:0pt; margin-bottom:0pt; font-size:10pt; font-family:Times New Roman;text-align:center"><ix:exclude>F-82</ix:exclude> </div></ix:continuation> </div></div> <ix:continuation id="TextSelectionAppend_161627633_10" continuedAt="TextSelectionAppend_161627633_11"><ix:exclude><div style="margin-top:1em; margin-bottom:0em; page-break-before:always"></div></ix:exclude></ix:continuation> <ix:continuation id="TextSelectionAppend_161627633_11" continuedAt="TextSelectionAppend_161627633_12"><ix:exclude><hr style="color:#999999;height:3px;width:100%;clear:both"/></ix:exclude></ix:continuation><ix:continuation id="TextSelectionAppend_161627633_12" continuedAt="TextSelectionAppend_161627633_13"><ix:exclude> <div style="font-size: 10pt; margin-top: 1.67em; margin-bottom: 1.67em;font-weight: bold;"><div style="font-weight:bolder;display:inline;"><a href="#toc">Table of Contents</a></div></div> </ix:exclude></ix:continuation></div></div> <div> <div> <div style="line-height:normal;display: inline;"> <div style="text-align:center"> <div style="width:8.5in;text-align:left;margin-left: auto;margin-right: auto"><ix:continuation id="TextSelectionAppend_16162763