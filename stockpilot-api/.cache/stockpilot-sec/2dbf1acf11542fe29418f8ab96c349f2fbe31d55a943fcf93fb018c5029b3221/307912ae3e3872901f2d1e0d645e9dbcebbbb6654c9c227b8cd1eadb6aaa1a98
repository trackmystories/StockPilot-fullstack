0.1pt;"> </span>claim<span style="letter-spacing:-0.1pt;"> </span>invalid even<span style="letter-spacing:-0.7pt;"> </span>though<span style="letter-spacing:-0.65pt;"> </span>the<span style="letter-spacing:-0.65pt;"> </span>same<span style="letter-spacing:-0.65pt;"> </span>evidence<span style="letter-spacing:-0.65pt;"> </span>would<span style="letter-spacing:-0.65pt;"> </span>be<span style="letter-spacing:-0.65pt;"> </span>insufficient<span style="letter-spacing:-0.65pt;"> </span>to<span style="letter-spacing:-0.7pt;"> </span>invalidate<span style="letter-spacing:-0.65pt;"> </span>the<span style="letter-spacing:-0.65pt;"> </span>claim<span style="letter-spacing:-0.65pt;"> </span>if<span style="letter-spacing:-0.35pt;"> </span>first<span style="letter-spacing:-0.7pt;"> </span>presented<span style="letter-spacing:-0.65pt;"> </span>in<span style="letter-spacing:-0.65pt;"> </span>a<span style="letter-spacing:-0.65pt;"> </span>district<span style="letter-spacing:-0.65pt;"> </span>court action.<span style="letter-spacing:-0.7pt;"> </span>Accordingly,<span style="letter-spacing:-0.65pt;"> </span>a<span style="letter-spacing:-0.65pt;"> </span>third<span style="letter-spacing:-0.65pt;"> </span>party<span style="letter-spacing:-0.65pt;"> </span>may<span style="letter-spacing:-0.65pt;"> </span>attempt<span style="letter-spacing:-0.65pt;"> </span>to<span style="letter-spacing:-0.65pt;"> </span>use<span style="letter-spacing:-0.7pt;"> </span>the<span style="letter-spacing:-0.65pt;"> </span>USPTO<span style="letter-spacing:-0.65pt;"> </span>procedures<span style="letter-spacing:-0.65pt;"> </span>to<span style="letter-spacing:-0.65pt;"> </span>invalidate<span style="letter-spacing:-0.65pt;"> </span>our<span style="letter-spacing:-0.65pt;"> </span>or<span style="letter-spacing:-0.65pt;"> </span>our<span style="letter-spacing:-0.7pt;"> </span>licensors&#8217; patent claims that would not have been invalidated if first challenged by the third party as a defendant in a district court 