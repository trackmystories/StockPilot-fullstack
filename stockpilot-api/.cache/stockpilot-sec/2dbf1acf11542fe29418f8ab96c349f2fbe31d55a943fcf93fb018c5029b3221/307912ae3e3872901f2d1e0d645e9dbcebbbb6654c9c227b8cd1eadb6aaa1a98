ix:nonFraction unitRef="Unit_Standard_USD_sEvDbHMtFEeao_rQ42TbXw" contextRef="As_Of_3_14_2026_us-gaap_DebtInstrumentAxis_zbio_SecuredDebtFutureTranchesMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_YCAf4i3r10aIVj7PUXbWYA" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="6" id="Narr_foX5cQUhOEGRMnsN3lvvqw">175.0</ix:nonFraction> million available as future tranches.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">The Term Loan bears interest at a rate of the 3-month <span style="-sec-ix-hidden:Hidden_HQwDTsSY-kGdEcVK3y0_hw;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">secured overnight financing rate</span></span> (subject to a <ix:nonFraction unitRef="Unit_Standard_pure_De5RdvBQjkOP5SPug_tYTw" contextRef="Duration_3_14_2026_To_3_14_2026_us-gaap_DebtInstrumentAxis_us-gaap_SecuredDebtMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_PE0gKRo3bUWNBUS1PhzPyg" decimals="4" format="ixt:num-dot-decimal" name="zbio:DebtInstrumentInterestRateFloor" scale="-2" id="Narr_Fqp-sSBwVUOM243vCmAQKA">3.25</ix:nonFraction>% floor) plus <ix:nonFraction unitRef="Unit_Standard_pure_De5RdvBQjkOP5SPug_tYTw" contextRef="Duration_3_14_2026_To_3_14_2026_us-gaap_DebtInstrumentAxis_us-gaap_SecuredDebtMember_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_PE0gKRo3bUWNBUS1PhzPyg" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" scale="-2" id="Narr_0ZuCvhAtY0iXynxzJY1qDA">5.75</ix:nonFraction>% payable quarterly in arrears; provided that the Company may elect for <ix:nonFraction unitRef="Unit_Standard_pure_De5RdvBQjkOP5SPug_tYTw" contextRef="As_Of_3_14_2026_us-g