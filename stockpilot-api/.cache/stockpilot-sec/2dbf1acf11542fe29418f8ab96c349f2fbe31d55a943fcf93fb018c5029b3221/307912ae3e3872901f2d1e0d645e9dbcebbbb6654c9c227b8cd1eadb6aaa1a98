an style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">for</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">indications</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">or</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">patient</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">populations</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">that</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">are</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">not</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">as</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">broad</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">as</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">intended</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">or</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">desired</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">or</span><span style="letter-spacing:-0.3pt;"> </span><span style="letter-spacing:-0.1pt;">obtain </span>approval<span style="letter-spacing:-0.45pt;"> </span>with<span style="letter-spacing:-0.45pt;"> </span>significant<span style="letter-spacing:-0.45pt;"> </span>use<span style="letter-spacing:-0.45pt;"> </span>or<span style="letter-spacing:-0.45pt;"> </span>distribution<span style="letter-spacing:-0.45pt;"> </span>restrictions<span style="letter-spacing:-0.45pt;"> </span>or<span style="letter-spacing:-0.45pt;"> </span>safety<span style="letter-spacing:-0.45pt;"> </span>warnings,<span style="lett