9b046c1b757568034dcbffa0ab79ccb90bb9fc0958a2d32bca703b8936407e6c[{"version":1,"source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"},"layers":{"businessProfile":{"status":"evidence_available","evidence":[{"id":"11954b1a74b6f2c98e43a134f92f51a61384614521083e8cd089cd21edee9bff","quote":"WTW is a leading global advisory, broking and solutions company that provides data-driven, insight-led solutions in the areas of people, risk and capital. Utilizing the global view and local expertise of our approximately 47,000 colleagues serving more than 140 countries and markets, we help organizations sharpen strategies, enhance resilience, motivate workforces and maximize performance. We design and deliver solutions that manage risk, optimize benefits, cultivate talent and expand the power of capital to protect and strengthen institutions and individuals. Working closely with our clients, we uncover opportunities for sustainable success.","context":"The Company","section":"ITEM 1. BUSINESS","block":52,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"ca09f7b0b07f47a1bdb33b6832b916be454c09b083f4874d9e2f3fd4d1c60ba1","quote":"Our clients operate on a global and local scale in a multitude of businesses and industries throughout the world and generally range in size from large, major multinational corporations to middle-market domestic and international companies. Our clients include many of the world’s leading corporations, including approximately 93% of the FTSE 100, 89% of the Fortune 1000, and 92% of the Fortune Global 500 companies. We also advise the majority of the world’s leading insurance companies. We work with major corporations, emerging growth companies, governmental agencies and not-for-profit institutions in a wide variety of industries, with many of our client relationships spanning decades. None of the Company’s clients individually represented more than 10% of its consolidated revenue for each of the years ended December 31, 2025, 2024 and 2023. We place insurance with approximately 2,500 insurance carriers, none of which individually accounted for a significant concentration of the total premiums we placed on behalf of our clients in 2025, 2024 or 2023.","context":"WTW is a leading global advisory, broking and solutions company that provides data-driven, insight-led solutions in the areas of people, risk and capital. Utilizing the global view and local expertise of our approximately 47,000 colleagues serving more than 140 countries and markets, we help organizations sharpen strategies, enhance resilience, motivate workforces and maximize performance. We design and deliver solutions that manage risk, optimize benefits, cultivate talent and expand the power of capital to protect and strengthen institutions and individuals. Working closely with our clients, we uncover opportunities for sustainable success.","section":"ITEM 1. BUSINESS","block":53,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"5d2c90a7277ebcd93faec25a41f75feb274206c90d1f6cd1d78e411aa8a0d94a","quote":"The Company files annual, quarterly and current reports, proxy statements and other information with the SEC. The SEC maintains a website that contains annual, quarterly and current reports, proxy statements and other information that issuers (including WTW) file electronically with the SEC. The SEC’s website is www.sec.gov.","context":"Available Information","section":"ITEM 1. BUSINESS","block":55,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"c70a4ac0dc17ccc57f489d8458370587df77846cf7b6301c5909221a851b936c","quote":"The Company makes available, free of charge through our website, www.wtwco.com, our Annual Report on Form 10-K, our quarterly reports on Form 10-Q, our proxy statement, current reports on Form 8-K and Forms 3, 4, and 5 filed on behalf of directors and Section 16 officers, as well as any amendments to those reports filed or furnished pursuant to the Securities Exchange Act of 1934 (the ‘Exchange Act’) as soon as reasonably practicable after such material is electronically filed with, or furnished to, the SEC. Unless specifically incorporated by reference, information on our website is not a part of this Form 10-K.","context":"The Company files annual, quarterly and current reports, proxy statements and other information with the SEC. The SEC maintains a website that contains annual, quarterly and current reports, proxy statements and other information that issuers (including WTW) file electronically with the SEC. The SEC’s website is www.sec.gov.","section":"ITEM 1. BUSINESS","block":56,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"3adfec4f4a2e1610f5048a236efc186bdf6accae8b7832b6c54936518d6c9783","quote":"The Company’s Memorandum and Articles of Association, Corporate Governance Guidelines, Audit Committee Charter, Risk and Operational Oversight Committee Charter, Human Capital and Compensation Committee Charter, and Corporate Governance and Nominating Committee Charter are available on our website, www.wtwco.com, in the Investor Relations section, or upon request. Requests for copies of these documents should be directed in writing to the Company Secretary c/o Office of General Counsel, Willis Towers Watson Public Limited Company, Brookfield Place, 200 Liberty Street, New York, NY 10281.","context":"The Company makes available, free of charge through our website, www.wtwco.com, our Annual Report on Form 10-K, our quarterly reports on Form 10-Q, our proxy statement, current reports on Form 8-K and Forms 3, 4, and 5 filed on behalf of directors and Section 16 officers, as well as any amendments to those reports filed or furnished pursuant to the Securities Exchange Act of 1934 (the ‘Exchange Act’) as soon as reasonably practicable after such material is electronically filed with, or furnished to, the SEC. Unless specifically incorporated by reference, information on our website is not a part of this Form 10-K.","section":"ITEM 1. BUSINESS","block":57,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"daaafe8988f628899dd0c1ad70669ae9889f495b9114b36f4f21a949f5d4b3b4","quote":"WTW offers its clients a broad range of services and solutions designed to help them identify and control risks, while also enhancing business performance by improving their ability to attract, retain and engage a talented workforce. Our risk control services span from strategic risk consulting, including actuarial analysis and various due diligence services, to practical on-site support such as health and safety or property loss control consulting, alongside analytical and advisory services like hazard modeling and climate risk quantification. We also assist clients in planning for and managing incidents or crises through services like contingency planning, security audits and product tampering plans. To further enhance business performance, we deliver consulting services, technology and solutions that help clients anticipate, identify and capitalize on emerging opportunities in human capital management, as well as offer investment guidance to help them develop disciplined and efficient strategies to meet their financial goals.","context":"General Information","section":"ITEM 1. BUSINESS","block":59,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"713ce023465d0205ce8dd0bc422bc3abf9e08e5e528aa4322563b09734b3a5a8","quote":"As an insurance broker, we act as an intermediary between our clients and insurance carriers by advising our clients on their risk management requirements, helping them to determine the best means of managing risk and negotiating and placing insurance with insurance carriers through our global distribution network.","context":"WTW offers its clients a broad range of services and solutions designed to help them identify and control risks, while also enhancing business performance by improving their ability to attract, retain and engage a talented workforce. Our risk control services span from strategic risk consulting, including actuarial analysis and various due diligence services, to practical on-site support such as health and safety or property loss control consulting, alongside analytical and advisory services like hazard modeling and climate risk quantification. We also assist clients in planning for and managing incidents or crises through services like contingency planning, security audits and product tampering plans. To further enhance business performance, we deliver consulting services, technology and solutions that help clients anticipate, identify and capitalize on emerging opportunities in human capital management, as well as offer investment guidance to help them develop disciplined and efficient strategies to meet their financial goals.","section":"ITEM 1. BUSINESS","block":60,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"73dc9b22a538995f80250ae63161d5aa039d02fc6d554844abdb5367ca6f4fc3","quote":"We operate a private Medicare marketplace in the U.S. through which, along with our active employee marketplace, we help our clients move to a more sustainable economic model by capping and controlling the costs associated with healthcare benefits.","context":"As an insurance broker, we act as an intermediary between our clients and insurance carriers by advising our clients on their risk management requirements, helping them to determine the best means of managing risk and negotiating and placing insurance with insurance carriers through our global distribution network.","section":"ITEM 1. BUSINESS","block":61,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"466b6fe9bf6d41b087c6b4c4a3b0e6c9bb35e82674576cda32da27419ad4a73e","quote":"We are not an insurance company, and therefore we do not underwrite insurable risks for our own account. We help sharpen strategies, enhance organizational resilience, motivate workforces and maximize performance to uncover opportunities for sustainable success.","context":"We operate a private Medicare marketplace in the U.S. through which, along with our active employee marketplace, we help our clients move to a more sustainable economic model by capping and controlling the costs associated with healthcare benefits.","section":"ITEM 1. BUSINESS","block":62,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"86af651e7032224608886cb35ca97e3b0c4fca7b6c34af2bd4d07a83c3cc7869","quote":"We derive the majority of our revenue from either commissions or fees for brokerage or from consulting services. We do not determine the insurance premiums on which our commissions are generally based. Commission levels generally follow the same trend as premium levels as they are derived from a percentage of the premiums paid by the insureds. Fluctuations in these premiums charged by the insurance carriers can therefore have a direct and potentially material impact on our results of operations. Our fees for consulting services are spread across a variety of complementary businesses that generally remain steady during times of uncertainty. We have some businesses, such as our health and benefits and administration businesses, which can be counter cyclical during the early period of a significant economic change.","context":"3","section":"ITEM 1. BUSINESS","block":64,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"a8b307777276e11f435063cc749a180432bccdc08c221fba8332e0ed958a862c","quote":"We believe that a unified and integrated approach to advisory, broking and solutions can be a path to growth for organizations around the world. We harness our collective power as ‘One WTW’ to make smart connections to serve and support our clients.","context":"Business Strategy","section":"Business Strategy","block":66,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"67c03e39b1b5898a4d8eb4a1524bc3e3c757812e5a60bdc5b9278d035f182fc4","quote":"We operate in attractive markets – both growing and mature – with a diversified platform across industries, segments and businesses globally.","context":"We believe that a unified and integrated approach to advisory, broking and solutions can be a path to growth for organizations around the world. We harness our collective power as ‘One WTW’ to make smart connections to serve and support our clients.","section":"Business Strategy","block":67,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"0b05b9d0f09ab64fb0fcb024042c85ef3911ea52c8db2acd8606704dc97bf76a","quote":"Our strategy is focused on extending and amplifying WTW’s strengths to deliver sustainable growth and profitability.","context":"We operate in attractive markets – both growing and mature – with a diversified platform across industries, segments and businesses globally.","section":"Business Strategy","block":68,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"4a0f875de65a9dea5115cec629cee2d7278cf9e6b05559acd8fe138b7ca5bf17","quote":"We believe we can achieve this through executing on three strategic objectives:","context":"Our strategy is focused on extending and amplifying WTW’s strengths to deliver sustainable growth and profitability.","section":"Business Strategy","block":69,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"71eaa6e8208246800fa4acde9048df1794e2cdf1d8ac5cdd1c252d7c1f9fe40b","quote":"Accelerate performance: By executing on the segment growth strategies to strengthen business fundamentals, advance innovative solutions and capitalize on our global footprint.","context":"•","section":"Business Strategy","block":71,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"78f409f55c65e2e2428eef74a603099dc6f2032ced49b63b6f19ef1effedb163","quote":"Enhance efficiency: By having a continuous improvement mindset, delivering operating leverage in our segments and leveraging WTW Enterprise Delivery Organization (WE DO) to focus on right work, right place, right tools and real estate optimization.","context":"•","section":"Business Strategy","block":73,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"80b5bc561482b2edb867fd2d109800b23cc504e83b66d271b55441dab61b995b","quote":"Optimize portfolio: By intentionally managing our portfolio through inorganic and organic investment in areas of strength and deepen our large and high-growth businesses with strategic investments in corporate risk and broking, health and benefits and wealth. Also, by divesting businesses that are no longer a strategic fit or do not align with our desired financial profile.","context":"•","section":"Business Strategy","block":75,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"dbd13a5f415900e3b4a4ecfa36f33e85a38cf6cab0ab3f6a8312f53f4ec4d1f4","quote":"These objectives are enabled by a focused investment framework and capital allocation strategy.","context":"Optimize portfolio: By intentionally managing our portfolio through inorganic and organic investment in areas of strength and deepen our large and high-growth businesses with strategic investments in corporate risk and broking, health and benefits and wealth. Also, by divesting businesses that are no longer a strategic fit or do not align with our desired financial profile.","section":"Business Strategy","block":76,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"d25acd55f708201a2e517011d6814dbe6459ba02e874a42c4e3a5726d71c8979","quote":"Through this strategy, we aim to grow revenue, improve margins and increase free cash flow, EBITDA and earnings. In turn, we’ll be able to fulfill our shared company purpose: We transform tomorrows.","context":"These objectives are enabled by a focused investment framework and capital allocation strategy.","section":"Business Strategy","block":77,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"e98cb0faa28cece9759bc430a216bf853042b7fca3300ca035eb9e707b69de41","quote":"We care as much about how we work as we do about the impact that we make. This means commitment to our shared purpose and values, a foundational framework that guides how we run our business and serve our clients. Our values of client focus, teamwork, integrity, respect and excellence underpin all that we do, and how we behave and interact with each other, our clients and our partners.","context":"Through this strategy, we aim to grow revenue, improve margins and increase free cash flow, EBITDA and earnings. In turn, we’ll be able to fulfill our shared company purpose: We transform tomorrows.","section":"Business Strategy","block":78,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"1523b92fe5baab74c8db6abe4d7ffb6c95753c3b5b7ceb6c7d9aefb829020537","quote":"For more information about risks to our strategic plans, see Part I, Item 1A Risk Factors of this Form 10-K.","context":"We care as much about how we work as we do about the impact that we make. This means commitment to our shared purpose and values, a foundational framework that guides how we run our business and serve our clients. Our values of client focus, teamwork, integrity, respect and excellence underpin all that we do, and how we behave and interact with each other, our clients and our partners.","section":"Business Strategy","block":79,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"31de04b676563573f5556fec7bdec933eec938d0d2eca6c800b2574596ddaf9a","quote":"We manage our business across two integrated reportable operating segments: Health, Wealth & Career and Risk & Broking. Below are the percentages of revenue generated by each segment for each of the years ended December 31, 2025, 2024 and 2023.","context":"Principal Services","section":"Business Strategy","block":81,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"fb88a7e58a80b8f4efc6102b125eeb42e6ed0a2e950deb339f4b729bb0362b83","quote":"| | | | | | | | | | | | | | Year ended December 31, | | | 2025 | | | 2024 | | | 2023 | Health, Wealth & Career | | | 55 | % | | | 59 | % | | | 60 | % Risk & Broking | | | 45 | % | | | 41 | % | | | 40 | %","context":"We manage our business across two integrated reportable operating segments: Health, Wealth & Career and Risk & Broking. Below are the percentages of revenue generated by each segment for each of the years ended December 31, 2025, 2024 and 2023.","section":"Business Strategy","block":82,"table":" |  |  |  |  |  |  |  |  |  |  |  | \n |  | Year ended December 31, | \n |  | 2025 |  |  | 2024 |  |  | 2023 | \nHealth, Wealth & Career |  |  | 55 | % |  |  | 59 | % |  |  | 60 | %\nRisk & Broking |  |  | 45 | % |  |  | 41 | % |  |  | 40 | %","attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"028207ba6880c0fd4fb6df538cbb16a5ac2e6a4a823dca67ae1554b8281033ea","quote":"The following presents descriptions of our segments:","context":"| | | | | | | | | | | | | | Year ended December 31, | | | 2025 | | | 2024 | | | 2023 | Health, Wealth & Career | | | 55 | % | | | 59 | % | | | 60 | % Risk & Broking | | | 45 | % | | | 41 | % | | | 40 | %","section":"Business Strategy","block":83,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"66553eedb1e6d6e2d09b9c62ad7b16b4d9523f991bead50090f698b70a15f8e4","quote":"The Health, Wealth & Career (‘HWC’) segment provides an array of advice, broking, solutions and technology for employee benefit plans, institutional investors, compensation and career programs, and the employee experience overall. Our portfolio of services support the interrelated challenges that the management teams of our clients face across human resources (‘HR’) and finance.","context":"Health, Wealth & Career","section":"Business Strategy","block":85,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"f4070fb4b3fca184e1a78e4a5b10fb3bc74f9d65055c53c9d33e379804475301","quote":"HWC is the larger of the two segments of the Company. Addressing four key areas, Health, Wealth, Career and Benefits Delivery & Outsourcing, the segment is focused on addressing our clients’ people and risk needs to help them succeed in a global marketplace.","context":"The Health, Wealth & Career (‘HWC’) segment provides an array of advice, broking, solutions and technology for employee benefit plans, institutional investors, compensation and career programs, and the employee experience overall. Our portfolio of services support the interrelated challenges that the management teams of our clients face across human resources (‘HR’) and finance.","section":"Business Strategy","block":86,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"09fc1f3ff6df0d478131b39deaf788106de24700e58f821339ff7d528609d342","quote":"The Health & Benefits (‘H&B’) business provides strategy and design consulting, plan management service and support, broking and administration across the full spectrum of health, wellbeing and other group benefit programs, including medical, dental, disability, life, voluntary benefits and other coverage. Our reach extends from small/mid-market clients to large-market and multinational clients, across the full geographic footprint of the Company, and to most industries. We can address our clients’ needs in more than 160 countries.","context":"Health","section":"Business Strategy","block":89,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"7d7e3176ceb03e6af1c9d3ababf6cfe53f57f72d453f9f078e5cd715096c837b","quote":"Our colleagues help clients make strategic decisions on topics such as optimizing program spend; evaluating emerging vendors, point solutions and coverage options (including publicly-subsidized health insurance exchanges and private exchanges in the U.S.); and dealing with above-inflation-rate increases in healthcare costs. We also assist clients in selecting the appropriate insurance carriers to cover benefit risks and administer the programs. In addition to our consulting and broking services, we manage a number of collective purchasing initiatives, such as pharmacy and stop-loss, that allow employers to realize greater value from third-party service providers than they can achieve on their own.","context":"The Health & Benefits (‘H&B’) business provides strategy and design consulting, plan management service and support, broking and administration across the full spectrum of health, wellbeing and other group benefit programs, including medical, dental, disability, life, voluntary benefits and other coverage. Our reach extends from small/mid-market clients to large-market and multinational clients, across the full geographic footprint of the Company, and to most industries. We can address our clients’ needs in more than 160 countries.","section":"Business Strategy","block":90,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"44c56ca500567401ef3fad45e4e7b047861160d483ba22aa3fce89b8227b8e90","quote":"With Global Benefits Management, our suite of global services supporting medical, dental and risk (e.g., life, disability) programs, we have a tailored offering for multinationals. This offering includes a flexible set of ready-made solutions, proven technology and an integrated approach to service delivery that translates to a globally consistent, high-quality experience for our clients.","context":"Our colleagues help clients make strategic decisions on topics such as optimizing program spend; evaluating emerging vendors, point solutions and coverage options (including publicly-subsidized health insurance exchanges and private exchanges in the U.S.); and dealing with above-inflation-rate increases in healthcare costs. We also assist clients in selecting the appropriate insurance carriers to cover benefit risks and administer the programs. In addition to our consulting and broking services, we manage a number of collective purchasing initiatives, such as pharmacy and stop-loss, that allow employers to realize greater value from third-party service providers than they can achieve on their own.","section":"Business Strategy","block":91,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"7751feb29067c345059551c9a95e865a8004bcffb41cd624e9843913d80bd688","quote":"A meaningful portion of revenue in this business is from recurring work, though contracts may be annual or multi-year. Given the balance of revenue across consulting, broking and solutions, our revenue is somewhat weighted to the first half of the year.","context":"With Global Benefits Management, our suite of global services supporting medical, dental and risk (e.g., life, disability) programs, we have a tailored offering for multinationals. This offering includes a flexible set of ready-made solutions, proven technology and an integrated approach to service delivery that translates to a globally consistent, high-quality experience for our clients.","section":"Business Strategy","block":92,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"c5800b16cc4e04f75e37f7475c864e8470a65a8ea20faa51a0f214f6a557d1f2","quote":"Our wealth-related businesses include Retirement and Investments.","context":"Wealth","section":"Business Strategy","block":94,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"dd641e2239ecc2be4d455bee5eec77e978ea80310ab3316a51338211a64bf4e9","quote":"Retirement — Our Retirement business provides actuarial support, plan design, and administrative services for all forms of pension and retirement savings plans. Our colleagues help clients assess the costs and risks of retirement plans on cash flow, earnings and the balance sheet, the effects of changing workforce demographics on their retirement plans, and retiree benefit adequacy and security. We offer clients a full range of integrated retirement consulting services and solutions to meet the needs of all types of employers. We help multinationals coordinate plan design and actuarial services across their complex global plans. We bring in-depth data analysis and perspective to their decision-making process as we have tracked the retirement designs and financing strategies of companies around the world over many decades.","context":"Our wealth-related businesses include Retirement and Investments.","section":"Business Strategy","block":95,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"18620403d61bd6e953ad0dbdec2b13f1f86441f22bf5f21bc1520eae9eea9818","quote":"For clients that want to outsource some or all of their pension plan management, we offer broking services as well as integrated solutions that can combine investment discretionary management, pension administration, core actuarial services, and communication and change management assistance.","context":"Retirement — Our Retirement business provides actuarial support, plan design, and administrative services for all forms of pension and retirement savings plans. Our colleagues help clients assess the costs and risks of retirement plans on cash flow, earnings and the balance sheet, the effects of changing workforce demographics on their retirement plans, and retiree benefit adequacy and security. We offer clients a full range of integrated retirement consulting services and solutions to meet the needs of all types of employers. We help multinationals coordinate plan design and actuarial services across their complex global plans. We bring in-depth data analysis and perspective to their decision-making process as we have tracked the retirement designs and financing strategies of companies around the world over many decades.","section":"Business Strategy","block":96,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"7910e0abc9afc8c2272f941bb6d885763629b7d9fa604ef2625fb277fd8b40a4","quote":"Retirement relationships are generally long-term in nature, and client retention rates for this business are high. A significant portion of the revenue in this business is from recurring work, with multi-year contracts that are driven by the heavily regulated nature of pension plans and our clients’ annual needs for these services.","context":"For clients that want to outsource some or all of their pension plan management, we offer broking services as well as integrated solutions that can combine investment discretionary management, pension administration, core actuarial services, and communication and change management assistance.","section":"Business Strategy","block":97,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"5c86e9ac432ee1c4ae437c648df1da83003196e6af0fdfac5e2ec8d3f4a0fdf9","quote":"Investments — Our Investments business provides advice and discretionary investment management solutions to defined benefit and defined contribution pension plans as well as to a range of other client types including insurers, endowments and foundations, and private wealth investors. We provide a solution to a significant business problem faced by our clients, namely sustaining the resources and skills required to deliver a financial services product in highly competitive capital markets. We offer a flexible approach that adapts to a wide range of client needs and circumstances, with the objective of higher returns, lower risk and lower costs within each client’s unique situation.","context":"Retirement relationships are generally long-term in nature, and client retention rates for this business are high. A significant portion of the revenue in this business is from recurring work, with multi-year contracts that are driven by the heavily regulated nature of pension plans and our clients’ annual needs for these services.","section":"Business Strategy","block":98,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"1bb86a5c35ca400c4c6b33c2dd8ab3f330e747b58896a002c6f34cc00b70cf03","quote":"Our solutions range from single asset class activity, through complete management of entire pension plan assets including sophisticated liability hedging programs as well as pooled employer plans/Master Trust under our LifeSight branding.","context":"Investments — Our Investments business provides advice and discretionary investment management solutions to defined benefit and defined contribution pension plans as well as to a range of other client types including insurers, endowments and foundations, and private wealth investors. We provide a solution to a significant business problem faced by our clients, namely sustaining the resources and skills required to deliver a financial services product in highly competitive capital markets. We offer a flexible approach that adapts to a wide range of client needs and circumstances, with the objective of higher returns, lower risk and lower costs within each client’s unique situation.","section":"Business Strategy","block":99,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"eadcd2f345d7b7ca36da89f02b5838d1d27132f0f92fe3f275964c9a79181ff0","quote":"We bring together a broad array of specialist investment knowledge and skills across all asset classes, a high-quality execution platform, a cost advantage through our scale, and expert advisors with experience across all client types from the largest plans in the world to small corporate pension plans.","context":"Our solutions range from single asset class activity, through complete management of entire pension plan assets including sophisticated liability hedging programs as well as pooled employer plans/Master Trust under our LifeSight branding.","section":"Business Strategy","block":100,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"708c7a75c2d35731f6144681943baa1645f8dec5377686b503dc9aa5dcd4763d","quote":"We have long-term relationships with our Investments clients, with the majority of our revenue driven by retainer contracts.","context":"We bring together a broad array of specialist investment knowledge and skills across all asset classes, a high-quality execution platform, a cost advantage through our scale, and expert advisors with experience across all client types from the largest plans in the world to small corporate pension plans.","section":"Business Strategy","block":101,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"b235260fab0d6e75e5e84babdeeb67211f171758dce9fb4fb8e3d53551cf3ba5","quote":"Our career-related offerings include advice, data, software and products to address clients’ total rewards and talent issues across the globe delivered through our Work & Rewards and Employee Experience businesses.","context":"Career","section":"Business Strategy","block":103,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"b25e246cac985f0972b48a257c8b823377ff63fa05a066e0c80c4365ceb4cccd","quote":"Work & Rewards — Within our Work & Rewards business, we help clients determine the best ways to get work done, the skills needed for jobs, and how to reward employees. We address executive compensation and broad-based rewards. We advise our clients’ management and boards of directors on all aspects of executive pay programs, including base pay, annual bonuses, long-term incentives, perquisites and other benefits. Our focus is on aligning pay plans with an organization’s business strategy and driving desired performance. Our solutions incorporate proprietary market benchmarking data and software to support compensation administration.","context":"5","section":"Business Strategy","block":105,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"f512ecca8daf364c4a51c2e1a12759248d242cd429052d6ca60f5950683f06f0","quote":"Employee Experience — Our Employee Experience business focuses on the provision of solutions including employee insight and listening tools, a technology platform that serves as a gateway for employees and plan participants to access their benefits and career information, communication and change management services.","context":"Work & Rewards — Within our Work & Rewards business, we help clients determine the best ways to get work done, the skills needed for jobs, and how to reward employees. We address executive compensation and broad-based rewards. We advise our clients’ management and boards of directors on all aspects of executive pay programs, including base pay, annual bonuses, long-term incentives, perquisites and other benefits. Our focus is on aligning pay plans with an organization’s business strategy and driving desired performance. Our solutions incorporate proprietary market benchmarking data and software to support compensation administration.","section":"Business Strategy","block":106,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"afff64e2357fce6244e57e75db9815f8db96ab2f67006a24ea945e478c5ea93a","quote":"Revenue for our career-related businesses is partly seasonal in nature, with heightened activity in the second half of the calendar year during the annual compensation, benefits and survey cycles. While these businesses enjoy long-term relationships with many clients, work in some parts of the businesses is project-based and can be sensitive to economic changes. We are increasingly adding tech-enabled solutions to our offerings across HWC, and in particular in Career. The businesses benefit from regulatory changes affecting our clients that require strategic advice, program changes and communication, the redefinition of jobs, work location and career paths as technology disaggregates work, and the recalibration of pay and the employee experience amidst shifting labor markets.","context":"Employee Experience — Our Employee Experience business focuses on the provision of solutions including employee insight and listening tools, a technology platform that serves as a gateway for employees and plan participants to access their benefits and career information, communication and change management services.","section":"Business Strategy","block":107,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"5c1013bfa082a44a8b9f3e6b3027b5a83d9d6369b2d15543c0d06613ba92f5a2","quote":"Our Benefits Delivery & Outsourcing businesses include Individual Marketplace and Global Outsourcing.","context":"Benefits Delivery & Outsourcing","section":"Business Strategy","block":109,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"b794e176701e3519b2b0d39660ae299ab7876fb8919785ad6c9c9ebea608c9b8","quote":"Individual Marketplace — Individual Marketplace offers decision support processes and tools to connect consumers with insurance carriers in private individual and Medicare markets. By leveraging multiple distribution channels and a diverse product portfolio, Individual Marketplace offers solutions to a broad consumer base, helping individuals compare, purchase and use health insurance products, tools and information. Individual Marketplace also provides Benefits Accounts to employees and retirees. These are tax-advantaged medical spending and savings accounts including health savings accounts (‘HSA’), health reimbursement accounts (‘HRA’) and flexible spending accounts (‘FSA’), such as dependent care/commuting flexible spending accounts.","context":"Our Benefits Delivery & Outsourcing businesses include Individual Marketplace and Global Outsourcing.","section":"Business Strategy","block":110,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"71db14fdb8e69a9a3633085039e4b2afc2afdedc26b7e6b33bf13a24468c0b61","quote":"Global Outsourcing — Global Outsourcing administers the health, welfare and retirement plans of clients using our proprietary technology for benefit modeling, decision support, enrollment and benefit choice, records management and self-service. Drawing on expertise in H&B and Retirement to create high-performing benefit plan designs, we believe we are well-positioned to help clients of all sizes simplify their benefits delivery, while lowering the total costs of benefits and related administration. Our technology also provides trustees and HR teams with timely management information to monitor activity and service levels and reduce administration costs.","context":"Individual Marketplace — Individual Marketplace offers decision support processes and tools to connect consumers with insurance carriers in private individual and Medicare markets. By leveraging multiple distribution channels and a diverse product portfolio, Individual Marketplace offers solutions to a broad consumer base, helping individuals compare, purchase and use health insurance products, tools and information. Individual Marketplace also provides Benefits Accounts to employees and retirees. These are tax-advantaged medical spending and savings accounts including health savings accounts (‘HSA’), health reimbursement accounts (‘HRA’) and flexible spending accounts (‘FSA’), such as dependent care/commuting flexible spending accounts.","section":"Business Strategy","block":111,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"02e90806e7b42a44be42dcd780d23b6cf859bab1db5e27fc4e22aae183b51131","quote":"With ongoing servicing requirements and multi-year contracts in place, we have high client retention rates. We provide plan administration services in North America, the U.K., Ireland and Germany.","context":"Global Outsourcing — Global Outsourcing administers the health, welfare and retirement plans of clients using our proprietary technology for benefit modeling, decision support, enrollment and benefit choice, records management and self-service. Drawing on expertise in H&B and Retirement to create high-performing benefit plan designs, we believe we are well-positioned to help clients of all sizes simplify their benefits delivery, while lowering the total costs of benefits and related administration. Our technology also provides trustees and HR teams with timely management information to monitor activity and service levels and reduce administration costs.","section":"Business Strategy","block":112,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"47de596d5cb3011bca656b4765e49f32e6dc8f15dd3a0c05f2073f5081e9464b","quote":"A significant portion of the revenue in Benefits Delivery & Outsourcing is recurring in nature, driven by either the commissions from the policies we sell, or from long-term service contracts with our clients that typically range from three to five years. Revenue across this business is seasonal and is generally higher in the fourth quarter as it is driven when typical annual enrollment activity occurs.","context":"With ongoing servicing requirements and multi-year contracts in place, we have high client retention rates. We provide plan administration services in North America, the U.K., Ireland and Germany.","section":"Business Strategy","block":113,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"7a53b8ffe21e9f8b567359948e738f4741f3b716152c32f00aeeaf0cabd8f0f8","quote":"The Risk & Broking (‘R&B’) segment provides a broad range of risk advice, insurance brokerage and consulting services to clients globally, ranging from small businesses to multinational corporations.","context":"Risk & Broking","section":"Business Strategy","block":115,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"efec5f16ca94f60935d8ad108305900e3430efe3e1ddf964bfd00c53bd3ee5a8","quote":"The segment comprises two primary businesses: our Corporate Risk & Broking and our Insurance Consulting and Technology businesses.","context":"The Risk & Broking (‘R&B’) segment provides a broad range of risk advice, insurance brokerage and consulting services to clients globally, ranging from small businesses to multinational corporations.","section":"Business Strategy","block":116,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"3a9b6a57c57bf9fe2b5529dcfc6c3cb038ac650abb90004a72daba8c83dd4caf","quote":"The CRB business places more than $34 billion of premiums into the insurance markets on an annual basis and delivers integrated global solutions tailored to client needs. This is underpinned by data and analytics through a balanced matrix of global lines of business and local Property and Casualty businesses, across four geographical areas: North America, Great Britain, Western Europe and International. Globally, and across the businesses, our specialized and data-driven approach is underpinned by our risk analytics and climate analytics propositions.","context":"Corporate Risk & Broking (‘CRB’)","section":"Business Strategy","block":118,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"f4ab8a121c63d3adece07ed8f56f21b760b63466de6cebc8091ddc8bf9164423","quote":"Across all businesses, our experts take an industry-focused approach to risk management and assessment, delivering broader perspectives and data-informed decision making to our clients. Our lines of business include Property and Casualty, Affinity, Risk & Analytics and our specialty global lines of business.","context":"The CRB business places more than $34 billion of premiums into the insurance markets on an annual basis and delivers integrated global solutions tailored to client needs. This is underpinned by data and analytics through a balanced matrix of global lines of business and local Property and Casualty businesses, across four geographical areas: North America, Great Britain, Western Europe and International. Globally, and across the businesses, our specialized and data-driven approach is underpinned by our risk analytics and climate analytics propositions.","section":"Business Strategy","block":119,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-069307","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526069307/wtw-20251231.htm","rawPath":"sec/raw/c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8.bin","sha256":"c50ae1927b30e0c78e8bbd397a09261f1be8e191bc0ece5d966833edc97c2ba8"}},{"id":"e83e3537681c9cc695ac985a919ffb1948259efe4f52254ac30491bb245e4a09","quote":"Prope