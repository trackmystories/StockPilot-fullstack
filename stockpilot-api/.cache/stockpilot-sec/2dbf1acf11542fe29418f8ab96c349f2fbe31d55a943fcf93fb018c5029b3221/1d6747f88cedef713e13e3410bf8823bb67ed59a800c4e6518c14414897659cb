ution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001802156-26-000016","form":"10-K","filedAt":"2026-03-04","reportDate":"2025-12-31","cik":"0001802156","url":"https://www.sec.gov/Archives/edgar/data/1802156/000180215626000016/xpof-20251231.htm","rawPath":"sec/raw/9a95168fee24abc57b0da8a4de6bb3f6b257df19df7cb62776789436b0ff4dc5.bin","sha256":"9a95168fee24abc57b0da8a4de6bb3f6b257df19df7cb62776789436b0ff4dc5"}},{"id":"dbe89e8de3ef1fa73f53f49a293b6732421c55b1b8fe27a679875a7a7d10e233","quote":"Deliver a world class member experience. We will use data as a competitive advantage to better understand our members and their preferences from the moment they join. We will continue to focus on attracting and retaining members by providing a best-in-class curated member experience.","context":"•","section":"Item 1. Business.","block":61,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001802156-26-000016","form":"10-K","filedAt":"2026-03-04","reportDate":"2025-12-31","cik":"0001802156","url":"https://www.sec.gov/Archives/edgar/data/1802156/000180215626000016/xpof-20251231.htm","rawPath":"sec/raw/9a95168fee24abc57b0da8a4de6bb3f6b257df19df7cb62776789436b0ff4dc5.bin","sha256":"9a95168fee24abc57b0da8a4de6bb3f6b257df19df7cb62776789436b0ff4dc5"}},{"id":"ca059a106c7b9c4e0bf83822e8e27bff3b03f04665efb5b06b7ebba6d5c8e12c","quote":"Become a data driven company. We are making appreciable investments in a data warehouse and reporting tools and other initiatives to develop consumer insights and trends.","context":"•","section":"Item 1. Business.","block":63,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001802156-26-000016","form":"10-K","filedAt":"2026-03-04","reportDate":"2025-12-31","cik":"0001802156","url":"https://www.sec.gov/Archives/edgar/data/1802156/00018021