</ix:nonNumeric><ix:nonNumeric contextRef="From2026-01-01to2026-06-30" escape="true" id="Fact001639" name="us-gaap:RelatedPartyTransactionsDisclosureTextBlock"><p id="xdx_808_eus-gaap--RelatedPartyTransactionsDisclosureTextBlock_zG2xzpREyDxe" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>Note
