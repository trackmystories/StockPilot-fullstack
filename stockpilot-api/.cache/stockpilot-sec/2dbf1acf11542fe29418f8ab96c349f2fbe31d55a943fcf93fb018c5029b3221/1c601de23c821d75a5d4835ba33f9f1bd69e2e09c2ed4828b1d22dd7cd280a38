losures in Topic 280. The ASU is effective for fiscal years beginning after December 15, 2023, and interim periods within fiscal years beginning after December 15, 2024, with early adoption permitted. The Company adopted FASB ASU 2023-07 on March 31, 2026, the date of its incorporation.","section":"Results of Operations","block":404,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001104659-26-095038","form":"10-Q","filedAt":"2026-08-12","reportDate":"2026-06-30","cik":"0002130386","url":"https://www.sec.gov/Archives/edgar/data/2130386/000110465926095038/yicc-20260630x10q.htm","rawPath":"sec/raw/50ccd7622e7fe3411ebc6ca5324f53de53897d13d00e6ac0eb984ee1abbf860c.bin","sha256":"50ccd7622e7fe3411ebc6ca5324f53de53897d13d00e6ac0eb984ee1abbf860c"}}],"omittedEvidenceCount":0}},"warnings":[]},{"version":1,"source":null,"layers":{"businessProfile":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"operatingKpis":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"managementExplanations":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"materialEvents":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"riskFactors":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"segmentIntelligence":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0}},"warnings":["Exhibit outside extraction scope (EX-31.1): /Archives/edgar/data/2130386/000110465926095038/yicc-20260630xex31d1.htm","Exhibit outside extraction scope (EX-31.2): /Archives/edgar/data/2130386/000110465926095038/yicc-20260630xex31d2.htm","Exhibit outside extraction scope (EX-32.1): /Archives/edgar/data/2130386/000110465926095038/yicc-20260630xex32d1.htm","Exhibit outside extraction scope (EX-32.2): /Archives/edgar/data/2130386/000110465926095038/yicc-20260630xex32d2.htm"]}]