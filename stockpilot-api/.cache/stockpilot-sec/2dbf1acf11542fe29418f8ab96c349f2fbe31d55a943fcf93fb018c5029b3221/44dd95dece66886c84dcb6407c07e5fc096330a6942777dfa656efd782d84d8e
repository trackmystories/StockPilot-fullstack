384a10fcc4ec0f66889bfdc524bf32a8142a8b297d00a260b3aafb243163ce6"}}],"omittedEvidenceCount":0},"managementExplanations":{"status":"evidence_available","evidence":[{"id":"c76d7b28683424abaf554e91be50b9e5ea742a64115acccb91d2b5b43bf42ff7","quote":"•The actual or perceived failure by us, our customers, partners, or vendors to comply with stringent and evolving laws and regulations, industry standards, policies, and contractual obligations relating to privacy, data protection, information security laws, and other matters could harm, and has in the past harmed, our reputation and business or subject us to significant fines and liability.","context":"•We have a limited operating history at the current scale of our business, which makes it difficult to evaluate our prospects and future results of operations.","section":"•We have a limited operating history at the current scale of our business, which makes it difficult to evaluate our prospects and future results of operations.","block":74,"table":null,"attribution":"management","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001585521-26-000030","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-31","cik":"0001585521","url":"https://www.sec.gov/Archives/edgar/data/1585521/000158552126000030/zm-20260131.htm","rawPath":"sec/raw/c384a10fcc4ec0f66889bfdc524bf32a8142a8b297d00a260b3aafb243163ce6.bin","sha256":"c384a10fcc4ec0f66889bfdc524bf32a8142a8b297d00a260b3aafb243163ce6"}},{"id":"4c1fe7f5571aecdba131bb9b9cc2f787b9fae565380a06935cb18782bad90f9e","quote":"•If we were to lose the services of our Chief Executive Officer or other members of our senior management team, we may not be able to execute our business strategy.","context":"•The actual or perceived failure by us, our customers, partners, or vendors to comply with stringent and evolving laws and regulations, industry standards, policies, and contractual obligations relating to privacy, data protection, information security laws, a