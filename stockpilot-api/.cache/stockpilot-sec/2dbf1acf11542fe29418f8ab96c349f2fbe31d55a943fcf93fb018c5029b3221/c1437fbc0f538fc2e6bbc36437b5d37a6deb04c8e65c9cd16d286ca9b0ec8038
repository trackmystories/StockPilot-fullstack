<ix:nonNumeric contextRef="c0" continuedAt="_ForeignCurrencyTransactionsAndTranslationsPolicyTextBlock-c0_cont_1" escape="true" name="us-gaap:ForeignCurrencyTransactionsAndTranslationsPolicyTextBlock" id="ixv-18686"><table cellpadding="0" style="font: 10pt Times New Roman, Times, Serif; width: 100%; margin-top: 0pt; margin-bottom: 0pt; border-spacing: 0px;"><tr style="vertical-align: top; text-align: justify">
