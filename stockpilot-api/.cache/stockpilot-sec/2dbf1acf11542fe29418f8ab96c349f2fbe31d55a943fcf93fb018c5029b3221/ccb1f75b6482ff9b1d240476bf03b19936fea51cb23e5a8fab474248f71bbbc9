97a8d6b1e48753a620c3771e9a5be1ca68cd1a2bbe7deaf103777871593d0236{"version":1,"source":{"accession":"0001213900-26-085283","form":"6-K","filedAt":"2026-08-04","reportDate":"2026-03-31","cik":"0001837821","url":"https://www.sec.gov/Archives/edgar/data/1837821/000121390026085283/ea0299626-6k_jin.htm","rawPath":"sec/raw/d26a36e4a5aaa9ffa774034cffb2b9c06bcdf5a298a3a5857ad3c3ee61936539.bin","sha256":"d26a36e4a5aaa9ffa774034cffb2b9c06bcdf5a298a3a5857ad3c3ee61936539"},"layers":{"businessProfile":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"operatingKpis":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"managementExplanations":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"materialEvents":{"status":"evidence_available","evidence":[{"id":"cafc0fdbc19baa46c9d9b3905f17470a8d7d41191a7ebe31a3816d236e71237a","quote":"On June 29, 2026, the Company entered into a VIE Control Acquisition and Share Issuance Agreement (the “Acquisition Agreement”) with Erhua Medical Technology (Changzhou) Co., Ltd. (“Erhua Med”), Beijing Tongsheng Technology Co., Ltd. (the “Target”), Chang Gil Lee (the “Seller”), and the share recipients identified therein solely for the limited purposes set forth in the Acquisition Agreement. Pursuant to the Acquisition Agreement, the Company and Erhua Med agreed to acquire contractual control over, and the right to receive substantially all of the economic benefits of, the Target through a series of contractual arrangements (the “VIE Agreements”). Neither the Company nor Erhua Med would acquire legal title to the equity interests of the Target. The details of the Acquisition Agreement were previously disclosed in the Company’s Form 6-K furnished on June 30, 2026.","context":"Completion of Acquisition","section":"","block":23,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001213900-26-085283","form":"6-K","filedAt":"2026-08-04","re