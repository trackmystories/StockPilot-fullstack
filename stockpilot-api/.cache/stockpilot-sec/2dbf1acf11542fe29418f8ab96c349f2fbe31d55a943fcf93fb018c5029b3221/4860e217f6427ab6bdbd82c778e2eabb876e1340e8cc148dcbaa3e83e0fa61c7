endently_verified","source":{"accession":"0001213900-26-098529","form":"6-K","filedAt":"2026-09-10","reportDate":"2026-09-09","cik":"0001966750","url":"https://www.sec.gov/Archives/edgar/data/1966750/000121390026098529/ea030476301ex99-1.htm","rawPath":"sec/raw/c76875556f69c0e25f9f9f733f27c478cf6d57991f52b516fe0178448360805e.bin","sha256":"c76875556f69c0e25f9f9f733f27c478cf6d57991f52b516fe0178448360805e"}},{"id":"dedecfcc7186bc5963818e14428eb6941c087fedc85bb5dafcf6a39a1e96be7f","quote":"(b)the Director who appointed him revokes his appointment by notice delivered to the Board or to the registered office of the Company or in any other manner approved by the Board; or","context":"(a)the Director who appointed him ceases to be a Director; or","section":"","block":749,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001213900-26-098529","form":"6-K","filedAt":"2026-09-10","reportDate":"2026-09-09","cik":"0001966750","url":"https://www.sec.gov/Archives/edgar/data/1966750/000121390026098529/ea030476301ex99-1.htm","rawPath":"sec/raw/c76875556f69c0e25f9f9f733f27c478cf6d57991f52b516fe0178448360805e.bin","sha256":"c76875556f69c0e25f9f9f733f27c478cf6d57991f52b516fe0178448360805e"}},{"id":"3c2ae7677f8461a801939b840221a532523ce1e17e19e235d5542a4d94f42d6e","quote":"15.11A Director who has appointed an alternate is not thereby relieved from the duties which he owes the Company.","context":"Status of the Director making the appointment","section":"","block":757,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001213900-26-098529","form":"6-K","filedAt":"2026-09-10","reportDate":"2026-09-09","cik":"0001966750","url":"https://www.sec.gov/Archives/edgar/data/1966750/000121390026098529/ea030476301ex99-1.htm","rawPath":"sec/raw/c76875556f69c0e25f9f9f733f27c478cf6d57991f52b516fe0178448360805e.bin","sha256":"c76875556f69c0e25f