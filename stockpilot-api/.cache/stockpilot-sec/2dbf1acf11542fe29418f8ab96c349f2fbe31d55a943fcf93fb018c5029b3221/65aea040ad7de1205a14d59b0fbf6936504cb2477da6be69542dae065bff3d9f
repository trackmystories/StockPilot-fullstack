ecimal" name="us-gaap:EmbeddedDerivativeFairValueOfEmbeddedDerivativeLiability" scale="3" id="Narr__P_FBSdIOEeuufFgSBl1Dw">865</ix:nonFraction> </p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-30</p></div></div>
