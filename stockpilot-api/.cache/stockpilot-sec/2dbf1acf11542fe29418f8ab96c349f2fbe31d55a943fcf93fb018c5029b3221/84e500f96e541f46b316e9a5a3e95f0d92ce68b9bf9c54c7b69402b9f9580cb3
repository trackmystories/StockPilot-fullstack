ations.","context":"•If we fail to timely and effectively obtain shipments of products from our manufacturers and deliver products to our retail partners and customers, our business and results of operations could be harmed.","section":"•If we fail to timely and effectively obtain shipments of products from our manufacturers and deliver products to our retail partners and customers, our business and results of operations could be harmed.","block":66,"table":null,"attribution":"management","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001670592-26-000013","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0001670592","url":"https://www.sec.gov/Archives/edgar/data/1670592/000167059226000013/yeti-20260103.htm","rawPath":"sec/raw/603ff009824bebc753397d66410255e9e435397e20b62a9bc9b258ef116ed257.bin","sha256":"603ff009824bebc753397d66410255e9e435397e20b62a9bc9b258ef116ed257"}},{"id":"32f76d1559c88f35eb13f35a2aa080640fa87e71720b8662b640074f9d60ca77","quote":"•Our business could be harmed if we fail to execute our plans to continue expanding our supply chain, technology and certain other business processes to a large global scale.","context":"•Our business is subject to the risk of manufacturer concentrations.","section":"•If we fail to timely and effectively obtain shipments of products from our manufacturers and deliver products to our retail partners and customers, our business and results of operations could be harmed.","block":67,"table":null,"attribution":"management","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001670592-26-000013","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0001670592","url":"https://www.sec.gov/Archives/edgar/data/1670592/000167059226000013/yeti-20260103.htm","rawPath":"sec/raw/603ff009824bebc753397d66410255e9e435397e20b62a9bc9b258ef116ed257.bin","sha256":"603ff009824bebc753397d66410255e9e435397e20b62a9bc9b258ef116ed257"}},{"i