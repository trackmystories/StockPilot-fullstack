d0b13124bcf4450489da18803ba84dfd1c0de.bin","sha256":"de2f790ea40081ea59934629537d0b13124bcf4450489da18803ba84dfd1c0de"}}],"omittedEvidenceCount":0},"materialEvents":{"status":"evidence_available","evidence":[{"id":"4843adb418e521f28002b741e9f9a0bc2c78dc8ba8ef299e331c20e482d9811e","quote":"This LIMITED WAIVER AND SECOND AMENDMENT TO AMENDED AND RESTATED CREDIT AND SECURITY AGREEMENT (this “Amendment”), dated as of January 21, 2026, is entered into by and among XBP Americas, LLC (formerly known as Exela Technologies BPA, LLC,) a Delaware limited liability company (the “Borrower”), BRF FINANCE CO. LLC, a Delaware limited liability company, as administrative agent (the “Agent”), and the financial institutions party to the Credit Agreement referred to below as a “Lender; and is acknowledged by the guarantors party to such Credit Agreement (the “Guarantors”).","context":"AMENDED AND RESTATED CREDIT AND SECURITY AGREEMENT","section":"","block":5,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001104659-26-037421","form":"10-K","filedAt":"2026-03-31","reportDate":"2025-12-31","cik":"0001839530","url":"https://www.sec.gov/Archives/edgar/data/1839530/000110465926037421/xbp-20251231xex10d22.htm","rawPath":"sec/raw/de2f790ea40081ea59934629537d0b13124bcf4450489da18803ba84dfd1c0de.bin","sha256":"de2f790ea40081ea59934629537d0b13124bcf4450489da18803ba84dfd1c0de"}},{"id":"d05fddf3398765dc7f4bd87bac712b4118622ffcc0a84767d475e638105b620e","quote":"“Additional Notes” means the notes issued under the terms of the Exit Notes Indenture subsequent to the Closing Date.","context":"2","section":"","block":417,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001104659-26-037421","form":"10-K","filedAt":"2026-03-31","reportDate":"2025-12-31","cik":"0001839530","url":"https://www.sec.gov/Archives/edgar/data/1839530/000110465926037421/xbp-20251231xex10d22.htm","rawPath":"sec/raw/de2f790ea40081ea59934629537d0b13124bcf4450489da18803ba84dfd1c0de.bin","sha256":"de2f790ea40081ea59934629537d0b13124bcf4450489da18803ba84dfd1c0de"}},{"id":"15ba1101347aaf79f89c4f1dbd8595240435f31cf0668380c1de758824ffff61","quote":"“Claims Administration Arrangements” means any and all arrangements entered into by any Exar Originator and any Claims Administration Bank whereby short-term loans (which loans shall be secured solely by Claim Administration Liens) are made by such Claims Administration Bank to any Exar Originator; provided, that the proceeds of such loans are deposited in one or more segregated deposit or securities accounts and are solely used to purchase Claims Administration Investments (which shall be held in such segregated accounts) and pay transaction costs in connection therewith.","context":"(3)except as expressly permitted pursuant to Section 5.6, the Borrower shall cease to, directly or indirectly own and control one hundred percent (100%) of each class of the outstanding equity interests of any Subsidiary the assets of which contribute more than $5,000,000 to the Borrowing Base.","section":"","block":455,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001104659-26-037421","form":"10-K","filedAt":"2026-03-31","reportDate":"2025-12-31","cik":"0001839530","url":"https://www.sec.gov/Archives/edgar/data/1839530/000110465926037421/xbp-20251231xex10d22.htm","rawPath":"sec/raw/de2f790ea40081ea59934629537d0b13124bcf4450489da18803ba84dfd1c0de.bin","sha256":"de2f790ea40081ea59934629537d0b13124bcf4450489da18803ba84dfd1c0de"}},{"id":"1d9f5e696290596df68944de5956e78be789f4e44cc3747c29b910767ef30c64","quote":"“Collateral” means, subject to the ABL Intercreditor Agreement, all property, now existing or hereafter acquired, mortgaged or pledged to, or purported to be subjected to a Lien in favor of, Agent, for the benefit of Agent 