gment reporting","block":133,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001493152-26-043473","form":"6-K","filedAt":"2026-09-21","reportDate":"2026-09-21","cik":"0002011458","url":"https://www.sec.gov/Archives/edgar/data/2011458/000149315226043473/ex99-2.htm","rawPath":"sec/raw/b69fa2012cbd01c930db7bed8a7a5c6c1c7b61107dad97e01b5a5923f7d450e5.bin","sha256":"b69fa2012cbd01c930db7bed8a7a5c6c1c7b61107dad97e01b5a5923f7d450e5"}},{"id":"70f90aedc5315f250c11b3f78a004648d066c98f2795ffb743c75c903dc81b8a","quote":"F-11","context":"The carrying amounts of non-current deposits and non-current amounts due to related parties approximate their respective fair values. Although these balances are non-interest-bearing, based on their expected recovery or settlement periods and the applicable market interest rates for comparable financial instruments, the effect of discounting is not material.","section":"Segment reporting","block":134,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001493152-26-043473","form":"6-K","filedAt":"2026-09-21","reportDate":"2026-09-21","cik":"0002011458","url":"https://www.sec.gov/Archives/edgar/data/2011458/000149315226043473/ex99-2.htm","rawPath":"sec/raw/b69fa2012cbd01c930db7bed8a7a5c6c1c7b61107dad97e01b5a5923f7d450e5.bin","sha256":"b69fa2012cbd01c930db7bed8a7a5c6c1c7b61107dad97e01b5a5923f7d450e5"}},{"id":"a7c97499b650adac356db99869113c5dfb8ff10801d0968e1f4ccf00716b0c6f","quote":"ZentoAI Intelligent Technology Company Limited","context":"F-11","section":"Segment reporting","block":135,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001493152-26-043473","form":"6-K","filedAt":"2026-09-21","reportDate":"2026-09-21","cik":"0002011458","url":"https://www.sec.gov/Archives/edgar/data/2011458/0001493152260434