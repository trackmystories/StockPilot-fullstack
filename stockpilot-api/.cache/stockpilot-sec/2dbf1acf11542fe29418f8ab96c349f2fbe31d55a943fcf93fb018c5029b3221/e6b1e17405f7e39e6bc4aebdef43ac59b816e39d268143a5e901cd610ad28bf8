4f37bf088ae485e2565e86a3f8318b2220651a271d138d48449bdaac6f3458db{"version":1,"source":{"accession":"0001213900-26-078731","form":"6-K","filedAt":"2026-07-16","reportDate":"2026-03-31","cik":"0001769256","url":"https://www.sec.gov/Archives/edgar/data/1769256/000121390026078731/ea0296080-6k_xchange.htm","rawPath":"sec/raw/9846771389d4dc09595cbc77276b3e5be5a9694c952c131163f3e51ecdb6845e.bin","sha256":"9846771389d4dc09595cbc77276b3e5be5a9694c952c131163f3e51ecdb6845e"},"layers":{"businessProfile":{"status":"evidence_available","evidence":[{"id":"4a8add8e2d3519eba6e9e6fa8e8beb324fd55a90fd24a916590b0a386cbaa05f","quote":"Business combinations are recorded using the acquisition method of accounting. The Company uses a screen to evaluate whether a transaction should be accounted for as an acquisition and/or disposal of a business versus assets. In order for a purchase to be considered an acquisition of a business, and receive business combination accounting treatment, the set of transferred assets and activities must include, at a minimum, an input and a substantive process that together significantly contribute to the ability to create outputs. If substantially all of the fair value of the gross assets acquired is concentrated in a single identifiable asset or a group of similar identifiable assets, then the set of transferred assets and activities is not a business.","context":"Business combination","section":"Business combination","block":215,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001213900-26-078731","form":"6-K","filedAt":"2026-07-16","reportDate":"2026-03-31","cik":"0001769256","url":"https://www.sec.gov/Archives/edgar/data/1769256/000121390026078731/ea0296080-6k_xchange.htm","rawPath":"sec/raw/9846771389d4dc09595cbc77276b3e5be5a9694c952c131163f3e51ecdb6845e.bin","sha256":"9846771389d4dc09595cbc77276b3e5be5a9694c952c131163f3e51ecdb6845e"}},{"id":"5ae91b68416bef227dd789ef0c0dc3a24274f9ad9fd72bf05a6105cfe961c7cb","quote":"The purchase price of business acquisition is allocated to the tangible assets, liabilities, identifiable intangible assets acquired and noncontrolling interest, if any, based on their estimated fair values as of the acquisition date. The excess of the purchase price over those fair values is recorded as goodwill. Acquisition-related expenses and restructuring costs are expensed as incurred.","context":"Business combinations are recorded using the acquisition method of accounting. The Company uses a screen to evaluate whether a transaction should be accounted for as an acquisition and/or disposal of a business versus assets. In order for a purchase to be considered an acquisition of a business, and receive business combination accounting treatment, the set of transferred assets and activities must include, at a minimum, an input and a substantive process that together significantly contribute to the ability to create outputs. If substantially all of the fair value of the gross assets acquired is concentrated in a single identifiable asset or a group of similar identifiable assets, then the set of transferred assets and activities is not a business.","section":"Business combination","block":216,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001213900-26-078731","form":"6-K","filedAt":"2026-07-16","reportDate":"2026-03-31","cik":"0001769256","url":"https://www.sec.gov/Archives/edgar/data/1769256/000121390026078731/ea0296080-6k_xchange.htm","rawPath":"sec/raw/9846771389d4dc09595cbc77276b3e5be5a9694c952c131163f3e51ecdb6845e.bin","sha256":"9846771389d4dc09595cbc77276b3e5be5a9694c952c131163f3e51ecdb6845e"}},{"id":"32832b9cc717f6462dd05a0b418f9a3a0659f9f6b576c70d4f97ae80025763da","quote":"Where the consideration in an acquisition includes contingent consideration and the payment of which depends on the achievement of certain specified conditions post-acquisition, the contingent consideration is recognized and measured at its fair value at the acquisition date and if recorded as a liability, it is subsequently carried at fair value with changes in fair value reflected in earnings.","context":"The purchase price of business acquisition is allocated to the tangible assets, liabilities, identifiable intangible assets acquired and noncontrolling interest, if any, based on their estimated fair values as of the acquisition date. The excess of the purchase price over those fair values is recorded as goodwill. Acquisition-related expenses and restructuring costs are expensed as incurred.","section":"Business combination","block":217,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001213900-26-078731","form":"6-K","filedAt":"2026-07-16","reportDate":"2026-03-31","cik":"0001769256","url":"https://www.sec.gov/Archives/edgar/data/1769256/000121390026078731/ea0296080-6k_xchange.htm","rawPath":"sec/raw/9846771389d4dc09595cbc77276b3e5be5a9694c952c131163f3e51ecdb6845e.bin","sha256":"9846771389d4dc09595cbc77276b3e5be5a9694c952c131163f3e51ecdb6845e"}},{"id":"6532f13e8c1482a83025f74200fe0c908691ac10ff2e09ffc567fd53f2045b42","quote":"Cash and cash equivalents consist of cash on hand and demand deposits, which are unrestricted as to withdrawal and use that which have original maturities of three months or less when purchased.","context":"Cash and cash equivalents","section":"Business combination","block":219,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001213900-26-078731","form":"6-K","filedAt":"2026-07-16","reportDate":"2026-03-31","cik":"0001769256","url":"https://www.sec.gov/Archives/edgar/data/1769256/000121390026078731/ea0296080-6k_xchange.htm","rawPath":"sec/raw/9846771389d4dc09595cbc77276b3e5be5a9694c952c131163f3e51ecdb6845e.bin","sha256":"9846771389d4d