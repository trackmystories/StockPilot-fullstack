y manner and take such other actions as may be required in order to keep such insurance in full force and effect. In all policies of director and officer liability insurance, Indemnitee shall be named as an insured in such a manner as to provide Indemnitee the same rights and benefits as are accorded to the most favorably insured of the Company’s officers and directors.","section":"","block":50,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001104659-26-018541","form":"10-K","filedAt":"2026-02-23","reportDate":"2025-12-31","cik":"0000795403","url":"https://www.sec.gov/Archives/edgar/data/795403/000110465926018541/wts-20251231xex10d8.htm","rawPath":"sec/raw/4a652905e0e87ad7a8706a2fe6a166d1d4333eadf53ab1a110dde70b1169a5a4.bin","sha256":"4a652905e0e87ad7a8706a2fe6a166d1d4333eadf53ab1a110dde70b1169a5a4"}}],"omittedEvidenceCount":0},"managementExplanations":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"materialEvents":{"status":"evidence_available","evidence":[{"id":"36f57ae1a6aa2071e1cbf39cfabc2d0a5a24e7932a233d7a2c64a70ed58a6734","quote":"This Agreement made and entered into this ___ day of ________ ____, (the “Agreement”), by and between Watts Water Technologies, Inc., a Delaware corporation (the “Company,” which term shall include, where appropriate, any Entity (as hereinafter defined) controlled directly or indirectly by the Company) and ____________ (the “Indemnitee”):","context":"INDEMNIFICATION AGREEMENT","section":"","block":3,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001104659-26-018541","form":"10-K","filedAt":"2026-02-23","reportDate":"2025-12-31","cik":"0000795403","url":"https://www.sec.gov/Archives/edgar/data/795403/000110465926018541/wts-20251231xex10d8.htm","rawPath":"sec/raw/4a652905e0e87ad7a8706a2fe6a166d1d4333eadf53ab1a110dde70b1169a5a4.bin","sha256":"4a652905e