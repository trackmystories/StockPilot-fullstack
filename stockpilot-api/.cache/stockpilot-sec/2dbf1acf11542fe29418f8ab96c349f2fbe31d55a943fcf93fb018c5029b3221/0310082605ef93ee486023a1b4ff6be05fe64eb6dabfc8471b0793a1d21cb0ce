a53ccfb37b7cef02fcfea01c76620a86937b289cb60d6ac642d1c98df1aac82d{"version":1,"source":{"accession":"0001524472-26-000012","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001524472","url":"https://www.sec.gov/Archives/edgar/data/1524472/000152447226000012/xyl-20251231.htm","rawPath":"sec/raw/95a2807d635c338325f7e9964e1063075f1a52c7182e2fe921aa0f56874b1904.bin","sha256":"95a2807d635c338325f7e9964e1063075f1a52c7182e2fe921aa0f56874b1904"},"layers":{"businessProfile":{"status":"evidence_available","evidence":[{"id":"098ce58d5c914a89cd2625b2b57bef8aedaa3c41e15423b731e8ab2b77a54ed4","quote":"Xylem is a leading global water technology company with 2025 revenues of $9.0 billion and approximately 22,000 employees worldwide. We design, manufacture and service engineered products and solutions across a wide variety of critical applications, primarily in the water sector. Our broad portfolio of products, services and solutions addresses customer needs of scarcity, resilience, quality, and affordability across the water cycle, from the delivery, treatment, measurement and use of drinking water, to the collection, testing, analysis and treatment of wastewater, to the return of water to the environment.","context":"Business Overview","section":"Business Overview","block":45,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001524472-26-000012","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001524472","url":"https://www.sec.gov/Archives/edgar/data/1524472/000152447226000012/xyl-20251231.htm","rawPath":"sec/raw/95a2807d635c338325f7e9964e1063075f1a52c7182e2fe921aa0f56874b1904.bin","sha256":"95a2807d635c338325f7e9964e1063075f1a52c7182e2fe921aa0f56874b1904"}},{"id":"c4eaa37fde6f35a6e9ff88ae9d67d50b2d1ddeb3bd852c7e8146bbbf77046c66","quote":"We have differentiated market positions in core applications including transport and dewatering, process water and wastewater treatment, analytics, smart metering, digital software solutions and comprehensive services. Setting us apart is a unique set of global assets that include:","context":"Xylem is a leading global water technology company with 2025 revenues of $9.0 billion and approximately 22,000 employees worldwide. We design, manufacture and service engineered products and solutions across a wide variety of critical applications, primarily in the water sector. Our broad portfolio of products, services and solutions addresses customer needs of scarcity, resilience, quality, and affordability across the water cycle, from the delivery, treatment, measurement and use of drinking water, to the collection, testing, analysis and treatment of wastewater, to the return of water to the environment.","section":"Business Overview","block":46,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001524472-26-000012","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001524472","url":"https://www.sec.gov/Archives/edgar/data/1524472/000152447226000012/xyl-20251231.htm","rawPath":"sec/raw/95a2807d635c338325f7e9964e1063075f1a52c7182e2fe921aa0f56874b1904.bin","sha256":"95a2807d635c338325f7e9964e1063075f1a52c7182e2fe921aa0f56874b1904"}},{"id":"bace8f82a53ad6abd859b55c00779d921a3c7b04bcac12dba25594ef430fd4fb","quote":"•Market-leading brands, some of which have been in use for more than 100 years","context":"We have differentiated market positions in core applications including transport and dewatering, process water and wastewater treatment, analytics, smart metering, digital software solutions and comprehensive services. Setting us apart is a unique set of global assets that include:","section":"Business Overview","block":47,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001524472-26-000012","form":"10-K","filedAt":"