64e1063075f1a52c7182e2fe921aa0f56874b1904"}},{"id":"a490305f60f2c9b6d2235bdd1ed4a52f952edc41879f70ed60ac33a75cd9178d","quote":"Our business is not dependent on any single customer or a few customers, the loss of which would have a material adverse effect on our Company. No individual customer accounted for more than 5% of our consolidated revenues in 2025, 2024 or 2023.","context":"Customers","section":"Business Segments, Distribution and Competitive Landscape","block":114,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001524472-26-000012","form":"10-K","filedAt":"2026-02-25","reportDate":"2025-12-31","cik":"0001524472","url":"https://www.sec.gov/Archives/edgar/data/1524472/000152447226000012/xyl-20251231.htm","rawPath":"sec/raw/95a2807d635c338325f7e9964e1063075f1a52c7182e2fe921aa0f56874b1904.bin","sha256":"95a2807d635c338325f7e9964e1063075f1a52c7182e2fe921aa0f56874b1904"}},{"id":"994e813770cdf4229e4550f8b7f747064b4aec3e6c83749a946725a3faf730d0","quote":"Backlog includes orders on hand as well as contractual customer agreements at the end of the period. Delivery schedules vary from customer to customer based on their requirements. Annual or multi-year contracts are subject to rescheduling and cancellation by customers due to the long-term nature of the contracts. As such, beginning total backlog, plus orders, minus revenues, will not equal ending total backlog due to contract adjustments, foreign currency fluctuations and other factors. Typically, capital projects require longer lead production cycles and deployment schedules, and delays occur from time to time. Total backlog was $4,615 million at December 31, 2025","context":"Backlog","section":"Business Segments, Distribution and Competitive Landscape","block":116,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001524472-26-000012","form":"10-K","f