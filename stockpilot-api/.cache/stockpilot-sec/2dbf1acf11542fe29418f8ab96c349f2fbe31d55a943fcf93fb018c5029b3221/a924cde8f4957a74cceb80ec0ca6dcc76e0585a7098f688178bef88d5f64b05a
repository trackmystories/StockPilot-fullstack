and $<ix:nonFraction contextRef="c271" decimals="0" format="ixt:num-dot-decimal" name="zcmd:RestrictedNetAssetsValue" scale="0" unitRef="usd" id="ixv-27210">13,139,835</ix:nonFraction> restricted net assets as of December 31, 2025 and 2024, respectively, as discussed above.</p></ix:continuation><div>

