portDate":"2025-12-31","cik":"0001083220","url":"https://www.sec.gov/Archives/edgar/data/1083220/000110465926043348/xelb-20251231x10k.htm","rawPath":"sec/raw/0b0a8f8d4dbfba528598f52fcc783f8e4a9691939edc3ae4905c0bee51370a09.bin","sha256":"0b0a8f8d4dbfba528598f52fcc783f8e4a9691939edc3ae4905c0bee51370a09"}},{"id":"3e3257f54b9ac03ae49521c6130a8b782242e81ad85ea4a004751cc96e5abdc6","quote":"●require us to dedicate a substantial portion of our cash flow to payments on our debt obligations, which reduces the availability of our cash flow to fund working capital, capital expenditures, and other corporate requirements;","context":"●could make it more difficult for us to satisfy our other obligations;","section":"Item 1A. Risk Factors","block":216,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001104659-26-043348","form":"10-K","filedAt":"2026-04-15","reportDate":"2025-12-31","cik":"0001083220","url":"https://www.sec.gov/Archives/edgar/data/1083220/000110465926043348/xelb-20251231x10k.htm","rawPath":"sec/raw/0b0a8f8d4dbfba528598f52fcc783f8e4a9691939edc3ae4905c0bee51370a09.bin","sha256":"0b0a8f8d4dbfba528598f52fcc783f8e4a9691939edc3ae4905c0bee51370a09"}},{"id":"d5e4e4c7db0b25d3d7b639452fcdb32662ca440b2b613f10b7af9b97af2c4af2","quote":"●could impede us from obtaining additional financing in the future;","context":"●require us to dedicate a substantial portion of our cash flow to payments on our debt obligations, which reduces the availability of our cash flow to fund working capital, capital expenditures, and other corporate requirements;","section":"Item 1A. Risk Factors","block":217,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001104659-26-043348","form":"10-K","filedAt":"2026-04-15","reportDate":"2025-12-31","cik":"0001083220","url":"https://www.sec.gov/Archives/edgar/data/1083220/000110465926043348/xelb-20