restInSubsidiary" contextRef="P06_04_2025To06_04_2025_OLCLPMemberifrsfullBusinessCombinationsAxis" unitRef="Unit_pure" decimals="2" scale="-2" format="ixt:num-dot-decimal" id="ixv-122321">100</ix:nonFraction>% of capital stock of OLCLP. </div> <div style="margin-top:6pt; margin-bottom:0pt; font-size:9pt; font-family:ARIAL;text-align:justify">The amount of the transaction was <ix:nonFraction name="ifrs-full:AcquisitiondateFairValueOfTotalConsiderationTransferred" contextRef="PAsOn06_04_2025_OLCLPMemberifrsfullBusinessCombinationsAxis" unitRef="Unit_USD" decimals="-6" scale="6" format="ixt:num-dot-decimal" id="ixv-122322">15</ix:nonFraction>, which was canceled by offsetting payment obligations assumed by Tecpetrol S.A. under a firm transportation services agreement for the &#8220;Vaca Muerta Sur&#8221; Pipeline of <ix:nonFraction name="ypf:BusinessCombinationsConsiderationTransferredByOffsettingPaymentObligations" contextRef="PAsOn06_04_2025_OLCLPMemberifrsfullBusinessCombinationsAxis" unitRef="Unit_USD" decimals="-5" scale="6" format="ixt:num-dot-decimal" id="ixv-122323">13.6</ix:nonFraction>, and the remaining balance of <ix:nonFraction name="ifrs-full:CashTransferred" contextRef="PAsOn06_04_2025_OLCLPMemberifrsfullBusinessCombinationsAxis" unitRef="Unit_USD" decimals="-5" scale="6" format="ixt:num-dot-decimal" id="ixv-122324">1.4</ix:nonFraction> in cash. </div> </ix:nonNumeric></div> </div> <ix:continuation id="TextSelection_158892323" continuedAt="TextSelectionAppend_158892323_1"><ix:exclude><div style="margin-top:1em; margin-bottom:0em; page-break-before:always"></div></ix:exclude></ix:continuation> <ix:continuation id="TextSelectionAppend_158892323_1" continuedAt="TextSelectionAppend_158892323_2"><ix:exclude><hr style="color:#999999;height:3px;width:100%;clear:both"/></ix:exclude></ix:continuation><ix:continuation id="TextSelectionAppend_158892323_2" continuedAt="TextSelectionAppend_158892323_3"><ix:exclude> <div style="font-size: 10pt; margin-top: 1.67em; mar