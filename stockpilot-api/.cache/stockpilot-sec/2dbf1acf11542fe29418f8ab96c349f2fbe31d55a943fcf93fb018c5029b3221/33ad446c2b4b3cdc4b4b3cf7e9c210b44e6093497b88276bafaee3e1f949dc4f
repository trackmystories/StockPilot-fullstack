x:nonFraction>, <ix:nonFraction name="ypf:EstimatedFairValueOfLoans" contextRef="PAsOn12_31_2024_EstimatedFairValueOfLoansMemberifrsfullClassesOfFinancialInstrumentsAxis_Level1OfFairValueHierarchyMemberifrsfullLevelsOfFairValueHierarchyAxis" unitRef="Unit_USD" decimals="-6" scale="6" format="ixt:num-dot-decimal" id="ixv-122999">8,811</ix:nonFraction> and <ix:nonFraction name="ypf:EstimatedFairValueOfLoans" contextRef="PAsOn12_31_2023_EstimatedFairValueOfLoansMemberifrsfullClassesOfFinancialInstrumentsAxis_Level1OfFairValueHierarchyMemberifrsfullLevelsOfFairValueHierarchyAxis" unitRef="Unit_USD" decimals="-6" scale="6" format="ixt:num-dot-decimal" id="ixv-123000">7,547</ix:nonFraction> as of December&#160;31, 2025, 2024 and 2023, respectively. </div> <div style="margin-top:6pt; margin-bottom:0pt; font-size:9pt; font-family:ARIAL;text-align:justify">The fair value of other receivables, trade receivables, cash and cash equivalents, other liabilities and accounts payable at amortized cost, do not differ significantly from their carrying amount. </div> </ix:continuation> <div style="font-size:8pt;margin-top:0pt;margin-bottom:0pt">&#160;</div> <ix:nonNumeric name="ifrs-full:DisclosureOfIntangibleAssetsExplanatory" contextRef="P01_01_2025To12_31_2025" escape="true" continuedAt="TextSelection_158892456" id="ixv-46840">
