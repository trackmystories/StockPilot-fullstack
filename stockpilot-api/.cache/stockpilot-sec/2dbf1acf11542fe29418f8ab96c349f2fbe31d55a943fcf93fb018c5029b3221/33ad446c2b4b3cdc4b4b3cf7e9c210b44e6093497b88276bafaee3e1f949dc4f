<td colspan="5" style="vertical-align:top"> <div style="margin-top: 0pt; margin-bottom: 0pt; font-size: 8pt; font-family: ARIAL; font-weight: bold; line-height: normal;">NOTES TO THE CONSOLIDATED FINANCIAL STATEMENTS</div> <div style="margin-top: 0pt; margin-bottom: 1pt; font-size: 8pt; font-family: ARIAL; font-weight: bold; line-height: normal;">AS OF DECEMBER 31, 2025, 2024 AND 2023</div> </td> </tr> </table> </ix:exclude></ix:continuation><ix:continuation id="TextSelectionAppend_158897006_53" continuedAt="TextSelectionAppend_158897006_54"><ix:exclude> <div style="margin-top:0pt; margin-bottom:0pt; font-size:8pt; font-family:ARIAL">(Amounts expressed in millions of United States dollars, except shares and per shares amounts expressed in United States dollars, and as otherwise indicated) </div> <div style="font-size:6pt;margin-top:0pt;margin-bottom:0pt">&#160;</div>
