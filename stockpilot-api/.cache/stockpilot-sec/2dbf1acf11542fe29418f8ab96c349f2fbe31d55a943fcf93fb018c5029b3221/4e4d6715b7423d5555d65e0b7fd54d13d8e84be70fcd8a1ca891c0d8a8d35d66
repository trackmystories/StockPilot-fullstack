million shares of common stock at an average of $<span id="xdx_90D_eus-gaap--SharePrice_iI_c20260131__dei--LegalEntityAxis__custom--StreetervilleCapitalLLCMember_zYhINvXrjrD" title="Share price"><ix:nonFraction name="us-gaap:SharePrice" contextRef="AsOf2026-01-31_custom_StreetervilleCapitalLLCMember" id="Fact000813" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">0.73</ix:nonFraction></span>
per share which offset principal of approximately $<span id="xdx_905_eus-gaap--DebtDefaultLongtermDebtAmount_iI_pn5n6_c20260131__dei--LegalEntityAxis__custom--StreetervilleCapitalLLCMember_zRkMG7rKJgb7" title="Debt amount"><ix:nonFraction name="us-gaap:DebtDefaultLongtermDebtAmount" contextRef="AsOf2026-01-31_custom_StreetervilleCapitalLLCMember" id="Fact000815" format="ixt:numdotdecimal" decimals="-5" scale="6" unitRef="USD">1.2</ix:nonFraction></span>
