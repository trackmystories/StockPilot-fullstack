    <td style="width: 0.5in"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">b.</span></td>
    <td><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Intangible assets acquired as a result of subsidiary acquisition</span></td></tr>
