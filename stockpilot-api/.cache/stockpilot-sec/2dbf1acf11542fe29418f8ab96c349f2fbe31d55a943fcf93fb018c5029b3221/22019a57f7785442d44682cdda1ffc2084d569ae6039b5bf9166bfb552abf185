,{"id":"d89dc97f2965adc31f2ad7ec98fd78789726782be3970235b15d9cdaa62e62ab","quote":"•Librela® (bedinvetmab), the first and only injectable mAb therapy for monthly alleviation of OA pain in dogs, was approved in the EU in 2020 and has since been approved in other key markets globally, including the U.S. in 2023;","context":"•Lenivia® (izenivetmab), the first and only long-acting injectable mAb therapy, with a three-month dosing interval, for the alleviation of osteoarthritis (OA) pain in dogs, was approved in the EU and Canada in 2025;","section":"Item 1. Business.","block":88,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001555280-26-000011","form":"10-K","filedAt":"2026-02-12","reportDate":"2025-12-31","cik":"0001555280","url":"https://www.sec.gov/Archives/edgar/data/1555280/000155528026000011/zts-20251231.htm","rawPath":"sec/raw/99f3ee451b8ac72c9c3ee2813e28254530c78387fb023f014d815d0e507914ff.bin","sha256":"99f3ee451b8ac72c9c3ee2813e28254530c78387fb023f014d815d0e507914ff"}},{"id":"b09e9e2f6290554e93d46d3b09a180c2166472b83354d000383237eb759e0381","quote":"•Portela® (relfovetmab), the first and only long-acting injectable mAb therapy, with a three-month dosing interval, for the alleviation of OA pain in cats, was approved in the EU and Canada in 2025;","context":"•Librela® (bedinvetmab), the first and only injectable mAb therapy for monthly alleviation of OA pain in dogs, was approved in the EU in 2020 and has since been approved in other key markets globally, including the U.S. in 2023;","section":"Item 1. Business.","block":89,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001555280-26-000011","form":"10-K","filedAt":"2026-02-12","reportDate":"2025-12-31","cik":"0001555280","url":"https://www.sec.gov/Archives/edgar/data/1555280/000155528026000011/zts-20251231.htm","rawPath":"sec/raw/99f3ee451b8ac7