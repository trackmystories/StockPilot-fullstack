style="font-size:10pt;font-family:Times New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_09b2e2ff-7766-45f5-96e7-7a1bf455a56f" contextRef="C_fe3ef6c6-0d75-4d58-bcee-d6ac56814b2d" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" unitRef="U_pure" scale="-2" decimals="4" format="ixt:num-dot-decimal">0.00</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">% to </span><span style="font-size:10pt;font-family:Times New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_aa8a00d0-e85f-47a4-ad82-b541743b55a2" contextRef="C_382c7f69-f827-41c6-8bf2-7d0e575b8963" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" unitRef="U_pure" scale="-2" decimals="5" format="ixt:num-dot-decimal">0.250</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">% (based upon the Company&#8217;s guaranteed senior-unsecured long-term debt rating). In addition, the Borrowers will pay a commitment fee in an amount equal to </span><span style="font-size:10pt;font-family:Times New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_31542a81-ba87-4fea-8acf-27f29f53b8ce" contextRef="C_bd9f18b9-174d-4a63-930d-5b07008a68ca" name="us-gaap:LineOfCreditFacilityUnusedCapacityCommitmentFeePercentage" unitRef="U_pure" scale="-2" decimals="5" format="ixt:num-dot-decimal">0.055</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">% to </span><span style="font-size:10pt;font-family:Times New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_e3129a14-2bec-45b5-affa-bf8c9d40680d" contex