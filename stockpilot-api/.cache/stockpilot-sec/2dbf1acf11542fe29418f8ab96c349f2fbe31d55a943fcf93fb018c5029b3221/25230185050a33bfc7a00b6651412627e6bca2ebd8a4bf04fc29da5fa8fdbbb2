ate":"2025-12-31","cik":"0001631761","url":"https://www.sec.gov/Archives/edgar/data/1631761/000121390026049159/ea0287206-20f_yirendigi.htm","rawPath":"sec/raw/78806d2960b23decc261fcb9c9b6f6ccf7df7316f845304af859081493efa54c.bin","sha256":"78806d2960b23decc261fcb9c9b6f6ccf7df7316f845304af859081493efa54c"}},{"id":"2fadeb59ee03a1887bfa636895ead334ca6fce15da730c69d68ede8f3ac5a8d6","quote":"In January 2026, we established Youpu Digital (Shanghai) Technology Co., Ltd., to provide loan facilitation service.","context":"In November 2025, we sold Yichuang Micro-lending to a third-party company.","section":"Item 4. Information on the Company","block":761,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001213900-26-049159","form":"20-F","filedAt":"2026-04-29","reportDate":"2025-12-31","cik":"0001631761","url":"https://www.sec.gov/Archives/edgar/data/1631761/000121390026049159/ea0287206-20f_yirendigi.htm","rawPath":"sec/raw/78806d2960b23decc261fcb9c9b6f6ccf7df7316f845304af859081493efa54c.bin","sha256":"78806d2960b23decc261fcb9c9b6f6ccf7df7316f845304af859081493efa54c"}},{"id":"174f44ddaafc044763648e36fefdba8442c2ce31cac4886952e7d638bcfe5ae9","quote":"In February 2026, we acquired 65% of the shares in PT Pinjaman Kemakmuran Rakyat to expand our business internationally.","context":"In January 2026, we established Youpu Digital (Shanghai) Technology Co., Ltd., to provide loan facilitation service.","section":"Item 4. Information on the Company","block":762,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001213900-26-049159","form":"20-F","filedAt":"2026-04-29","reportDate":"2025-12-31","cik":"0001631761","url":"https://www.sec.gov/Archives/edgar/data/1631761/000121390026049159/ea0287206-20f_yirendigi.htm","rawPath":"sec/raw/78806d2960b23decc261fcb9c9b6f6ccf7df7316f845304af859081493efa54c.bin","sha256":"78806d2960b23