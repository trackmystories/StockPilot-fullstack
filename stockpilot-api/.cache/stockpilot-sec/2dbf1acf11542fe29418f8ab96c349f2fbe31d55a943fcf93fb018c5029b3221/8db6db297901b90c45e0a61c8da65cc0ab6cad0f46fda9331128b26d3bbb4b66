,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-325374","form":"10-Q","filedAt":"2026-07-30","reportDate":"2026-06-30","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526325374/wtw-ex10_3.htm","rawPath":"sec/raw/8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449.bin","sha256":"8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449"}},{"id":"a0d2d71a520839a0078a23a5b1285dc2985003d0c5fd60e602b3907f0d9bd09e","quote":"This Policy will be reviewed at least annually, and the Policy Owner will be required to attest to policy adherence with material changes advised to the Privacy Team, for their approval. Global Privacy Office shall agree if such changes require escalation.","context":"Policy review/material changes to Policy","section":"business and/or commercial purposes for collecting and selling their personal information;","block":496,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-325374","form":"10-Q","filedAt":"2026-07-30","reportDate":"2026-06-30","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526325374/wtw-ex10_3.htm","rawPath":"sec/raw/8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449.bin","sha256":"8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449"}},{"id":"70ba1557faa6db668832ed2c46f926daf480c939a4c3ee6b62904b82c3609e0d","quote":"\"Special categories of personal information\" is personal data revealing racial or ethnic origin, political opinions, religious or philosophical beliefs, or trade union membership, genetic data or biometric data processed for the purpose of uniquely identifying a natural person, data concerning health or data concerning a natural person’s sex life or sexual orientation. WTW also treats information relating to criminal convictions and offences as falling within the definition of special categories of personal information.","context":"4.1","section":"business and/or commercial purposes for collecting and selling their personal information;","block":500,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-325374","form":"10-Q","filedAt":"2026-07-30","reportDate":"2026-06-30","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526325374/wtw-ex10_3.htm","rawPath":"sec/raw/8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449.bin","sha256":"8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449"}},{"id":"1f54c4c0343dd6db614ca49d0b34ca56c01a2d66fd98414dc368b195d2b8a519","quote":"WTW collects the following types of special categories of personal information:","context":"4.2","section":"business and/or commercial purposes for collecting and selling their personal information;","block":502,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-325374","form":"10-Q","filedAt":"2026-07-30","reportDate":"2026-06-30","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526325374/wtw-ex10_3.htm","rawPath":"sec/raw/8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449.bin","sha256":"8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449"}},{"id":"7882f1ea3d61ada972ae2e0f953045bb31922884eb81341f6ce890ca21e380e5","quote":"Information about health and criminal convictions and offences for insurance purposes and claims handling in relation to insured individuals, claimants and related third parties.","context":"(a)","section":"business and/or commercial purposes for collecting and selling their personal information;","block":504,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-325374","form":"10-Q","filedAt":"2026-07-30","reportDate":"2026-06-30","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526325374/wtw-ex10_3.htm","rawPath":"sec/raw/8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449.bin","sha256":"8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449"}},{"id":"80e3e86c15c65de633ce9d0760226a909c2dc629800765246f72c0e2206c75be","quote":"Information about health for actuarial, pension scheme, and other benefits consultancy services.","context":"(b)","section":"business and/or commercial purposes for collecting and selling their personal information;","block":506,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-325374","form":"10-Q","filedAt":"2026-07-30","reportDate":"2026-06-30","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526325374/wtw-ex10_3.htm","rawPath":"sec/raw/8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449.bin","sha256":"8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449"}},{"id":"8dc4c50d928c1aa86b12530fdf11f590873f1d5cc3a04ba98a27e50ce98df527","quote":"Information about health and criminal convictions and offences for human resources management purposes in relation to employees, contractors and agents.","context":"(c)","section":"business and/or commercial purposes for collecting and selling their personal information;","block":508,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-325374","form":"10-Q","filedAt":"2026-07-30","reportDate":"2026-06-30","cik":"0001140536","url":"https://www.sec.gov/Archives/edgar/data/1140536/000119312526325374/wtw-ex10_3.htm","rawPath":"sec/raw/8cc072d93de91649245027796444e95567f8a931ac4ee755a8158c7aa6cd1449.bin","sha256":"8cc072d9