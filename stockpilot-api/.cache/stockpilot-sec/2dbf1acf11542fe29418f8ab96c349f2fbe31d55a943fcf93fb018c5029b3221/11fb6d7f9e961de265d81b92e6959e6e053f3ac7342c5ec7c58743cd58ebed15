l.htm","rawPath":"sec/raw/df2abbfe74d1130cce59745b83627ea472f539355dc80e6ec8a573da208603a7.bin","sha256":"df2abbfe74d1130cce59745b83627ea472f539355dc80e6ec8a573da208603a7"}},{"id":"58130b32d1a15b8a87edc771676c0e01de7c2f3b2233640fe787515e93ff7858","quote":"4.Given the particular characteristics of the development of the Land, the gross construction areas allocated to the gaming areas, integrated within the gross construction area designated for the purpose of \"Five-star hotel\", shall be operated by Wynn Resorts (Macau) S.A. in its capacity as third signatory of this contract and as holder of a concession for the operation of games of fortune or chance or other games in casinos in the Macau Special Administrative Region.","context":"3.The second signatory shall comply with the urban planning regulations in force in the zone where the Land is located.","section":"","block":41,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001174922-26-000047","form":"8-K","filedAt":"2026-07-22","reportDate":"2026-07-21","cik":"0001174922","url":"https://www.sec.gov/Archives/edgar/data/1174922/000117492226000047/ex101-firstamendmenttothel.htm","rawPath":"sec/raw/df2abbfe74d1130cce59745b83627ea472f539355dc80e6ec8a573da208603a7.bin","sha256":"df2abbfe74d1130cce59745b83627ea472f539355dc80e6ec8a573da208603a7"}}],"omittedEvidenceCount":0},"managementExplanations":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"materialEvents":{"status":"evidence_available","evidence":[{"id":"9aa9e6d4b66fe4da28e7efa82c4bfb858dd61e181fe951228a227573303ce9f4","quote":"2.Given that the contract for the concession for the operations of casino games of fortune initially entered into between Wynn Resorts (Macau) S.A. and the Macau Special Administrative Region expired on December 31, 2022, and for the purpose of complying with the provisions of Law No. 16/2001 (Legal Framework for the Operations of Casino Games of Fortune), as amended by Law No. 7/2022, the Macau Special Administrative Region acquired, by reversion, a share of 83.9/1000 of the aforesaid urban property, whose right is registered at the Land Registry under No. 398158G.","context":"1.By Order of the Secretary for Transport and Public Works no. 16/2012, published in the Official Gazette of the Macau Special Administrative Region No. 18, Series II, of May 2, 2012, the contract for the concession, by lease and with exemption of public tender, of a plot of land with an area of 205,797 m², situated in the reclaimed zone of Cotai, at Avenida do Aeroporto Nos. 1163 to 1409, Avenida da Nave Desportiva Nos. 858 to 1160, Rua da Patinagem Nos. 791 to 1021, and Avenida Dr. Henry Fok Nos. 640 to 730, described at the Land Registry under No. 23305, was granted to Palo Real Estate Company Limited, a subsidiary of Wynn Resorts (Macau) S.A., the holder of a concession for the operations of casino games of fortune in the Macau Special Administrative Region, with its registered office at Ground Floor, Wynn Palace, Avenida da Nave Desportiva, Cotai, Macau, and registered at the Commercial and Movable Property Registry under No. 27319 (SO), whose rights deriving from the concession are registered under No. 33218F.","section":"","block":11,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001174922-26-000047","form":"8-K","filedAt":"2026-07-22","reportDate":"2026-07-21","cik":"0001174922","url":"https://www.sec.gov/Archives/edgar/data/1174922/000117492226000047/ex101-firstamendmenttothel.htm","rawPath":"sec/raw/df2abbfe74d1130cce59745b83627ea472f539355dc80e6ec8a573da208603a7.bin","sha256":"df2abbfe74d1130cce59745b83627ea472f539355dc80e6ec8a573da208603a7"}}],"omittedEvidenceCount":0},"riskFactors":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"segmentIntelligence":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0}},"warni