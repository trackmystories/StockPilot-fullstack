ViI3i6nfphg" contextRef="Duration_4_1_2025_To_6_30_2025_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_xxii_GvbbiopharmaMember_7EcpvXZxTEKTcfsBAe9_Rw" decimals="-3" format="ixt:num-dot-decimal" name="xxii:AccruedLiabilitiesSettled" scale="3" id="Narr_HP7N1nt5N0C9lAMgVlUeDw">84</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_Zamg5luc5U6ViI3i6nfphg" contextRef="Duration_1_1_2026_To_6_30_2026_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_xxii_GvbBiopharmaMember_iAdqqj1ec0qvlMAGixfPgA" decimals="-3" format="ixt:num-dot-decimal" name="xxii:AccruedLiabilitiesSettled" scale="3" id="Narr_cQmVKs2B8Uekc25WYqJWjw">421</ix:nonFraction>, respectively<span style="background:#ffffff;">.</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;background:#ffffff;margin:0pt;">Effective June 24, 2024, GVB Biopharma (&#8220;GVB&#8221;), the Company&#8217;s former subsidiary, made a scheduled principal and interest payment against the Company&#8217;s prior outstanding indebtedness to JGB under the former Senior Secured Credit Facility, reducing the Company&#8217;s total outstanding principal indebtedness with JGB by&#160;$<ix:nonFraction unitRef="Unit_Standard_USD_Zamg5luc5U6ViI3i6nfphg" contextRef="Duration_6_24_2024_To_6_24_2024_us-gaap_DebtInstrumentAxis_xxii_GvbPromissoryNote2023Member_us-gaap_PledgingPurposeAxis_us-gaap_BorrowingsMember_bPzBJm0n5U-MHBckNpdLBA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentIncreaseDecreaseForPeriodNet" scale="3" id="Narr_sP9n1PX4_UysY03mcfg78g">1,500</ix:nonFraction>. The remaining&#160;$<ix:nonFraction unitRef="Unit_Standard_USD_Zamg5luc5U6ViI3i6nfphg" contextRef="As_Of_6_24_2024_us-gaap_AccountsNotesLoansAndFinancingReceivableByReceivableTypeAxis_xxii_GvbPromissoryNote2023Member_-9FnyT3XnUaEjPmBRboIBw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:FinancingReceivableExcludingAccruedInterestAfterAllowanceForCreditLoss" scale="3" id="Narr_IIL8eZeTDkmR-lI6zcRNgg">500</ix:nonFraction>&#160;payable by GVB under the 2023 GVB Promissory Note was initially extended to December 31, 2024, and subsequently to March 31, 2025. &#160;As of March 31, 2025, the 2023 GVB Promissory Note was in default with respect to payment at maturity of the contractual term and accordingly an allowance for credit loss was initially recorded as of March 31, 2025 in the amount of&#160;$<ix:nonFraction unitRef="Unit_Standard_USD_Zamg5luc5U6ViI3i6nfphg" contextRef="As_Of_6_30_2025_us-gaap_AccountsNotesLoansAndFinancingReceivableByReceivableTypeAxis_xxii_GvbPromissoryNote2023Member_a_tPVk07WU2WQbm66TJFyQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:FinancingReceivableAllowanceForCreditLossExcludingAccruedInterest" scale="3" id="Narr_EcEwp4aDgkyiRsOLXgYdRA">500</ix:nonFraction>. &#160;</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;background:#ffffff;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;background:#ffffff;margin:0pt;">In connection with the September 18, 2025 full repayment of the Senior Secured Credit Facility, the Company entered into a new 2025 GVB Promissory Note with GVB in the amount of&#160;$<ix:nonFraction unitRef="Unit_Standard_USD_Zamg5luc5U6ViI3i6nfphg" contextRef="Duration_9_18_2025_To_9_18_2025_us-gaap_AccountsNotesLoansAndFinancingReceivableByReceivableTypeAxis_xxii_GvbPromissoryNote2025Member_AnyOf62W9ESYbCss4Cnsbg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:PaymentsToAcquireNotesReceivable" scale="3" id="Narr_4djJhwC4x0q_GhP9HKpomg">500</ix:nonFraction>, payable in installments of&#160;$<ix:nonFraction unitRef="Unit_Standard_USD_Zamg5luc5U6ViI3i6nfphg" contextRef="As_Of_