<ix:nonNumeric contextRef="d_2024-10-01_2025-09-30" name="cyd:CybersecurityRiskManagementProcessesIntegratedTextBlock" id="c138972052">To mitigate the threat to our business, we take a comprehensive approach to cybersecurity risk management.</ix:nonNumeric>
<ix:nonNumeric contextRef="d_2024-10-01_2025-09-30" name="cyd:CybersecurityRiskThirdPartyOversightAndIdentificationProcessesFlag" id="c138972053" format="ixt:fixed-true">true</ix:nonNumeric>
