  <ix:nonNumeric contextRef="d_2025-10-01_2026-06-30" name="us-gaap:SubsequentEventsTextBlock" id="c3260191" escape="true">
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"><b>NOTE <em style="font: inherit;">17</em>&#160;</b>&#8211;<b> SUBSEQUENT EVENTS</b></p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#160;</p>
   <p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: justify;">On <em style="font: inherit;"> July 1, 2026, </em>the Company paid accrued dividends of $<ix:nonFraction id="c149601429" contextRef="d_2026-07-01_2026-07-01_StatementClassOfStockAxis-SeriesBPreferredStockMember_SubsequentEventTypeAxis-SubsequentEventMember" unitRef="USD" name="us-gaap:StockIssuedDuringPeriodValueStockDividend" scale="0" format="ixt:num-dot-decimal" decimals="INF">14,780</ix:nonFraction> and $<ix:nonFraction id="c149601430" contextRef="d_2026-07-01_2026-07-01_StatementClassOfStockAxis-SeriesCPreferredStockMember_SubsequentEventTypeAxis-SubsequentEventMember" unitRef="USD" name="us-gaap:StockIssuedDuringPeriodValueStockDividend" scale="0" format="ixt:num-dot-decimal" decimals="INF">56,250</ix:nonFraction>&#160;related to the Series B and Series C Preferred Stock, respectively, paid in <ix:nonFraction id="c149601431" contextRef="d_2026-07-01_2026-07-01_StatementClassOfStockAxis-SeriesBPreferredStockMember_SubsequentEventTypeAxis-SubsequentEventMember" unitRef="Share" name="us-gaap:CommonStockDividendsShares" scale="0" format="ixt:num-dot-decimal" decimals="INF">14,780</ix:nonFraction> and&#160;<ix:nonFraction id="c149601432" contextRef="d_2026-07-01_2026-07-01_StatementClassOfStockAxis-SeriesCPreferredStockMember_SubsequentEventTypeAxis-SubsequentEventMember" unitRef="Share" name="us-gaap:CommonStockDividendsShares" scale="0" format="ixt:num-dot-decimal" decimals="INF">49,778</ix:nonFraction> shares of common stock.&#160;</p>
   <p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: justify;">&#160;</p>
   <p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: justify;">On <em style="font: inherit;"> July 12, 2026 </em>the Company granted <ix:nonFraction id="c149601433" contextRef="d_2026-07-12_2026-07-12_AwardTypeAxis-RestrictedStockUnitsRSUMember_SubsequentEventTypeAxis-SubsequentEventMember" unitRef="Share" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod" scale="0" format="ixt:num-dot-decimal" decimals="INF">65,000</ix:nonFraction> shares of RSUs under the Company's <em style="font: inherit;">2025</em> equity incentive plan to select employees of which <em style="font: inherit;">one</em> <span style="-sec-ix-hidden:c149601436">third</span> vest immediately, <em style="font: inherit;">one</em> <span style="-sec-ix-hidden:c149601438">third</span> vests on <em style="font: inherit;"> July 12, 2027 </em>and the remaining <em style="font: inherit;">one</em> <span style="-sec-ix-hidden:c149601440">third</span> vests on <em style="font: inherit;"> July 12, 2028.</em></p>
   <p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: justify;">&#160;</p>
   <p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: justify;"><span style="background-color:#ffff00;">PLACEHOLDER FOR TL</span></p>
