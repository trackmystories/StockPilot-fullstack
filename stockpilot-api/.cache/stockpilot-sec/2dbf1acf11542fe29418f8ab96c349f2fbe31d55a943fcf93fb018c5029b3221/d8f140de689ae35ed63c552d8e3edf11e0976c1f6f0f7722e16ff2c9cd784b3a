</td><td valign="bottom" style="padding-left:2pt;padding-right:2pt"><p style="font:9pt Times New Roman;margin:0;color:#000000;text-align:right"> &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;(<ix:nonFraction name="ifrs-full:DilutedEarningsLossPerShare" contextRef="Y24" decimals="INF" unitRef="UsdPerShare" sign="-" scale="0" format="ixt:num-dot-decimal" id="ixv-25459">0.22</ix:nonFraction>) </p>
</td></tr>
