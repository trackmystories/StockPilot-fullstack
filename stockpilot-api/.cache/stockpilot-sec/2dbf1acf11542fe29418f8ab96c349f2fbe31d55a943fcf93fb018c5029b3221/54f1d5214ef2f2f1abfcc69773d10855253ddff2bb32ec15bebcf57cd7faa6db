<td style="width:4%;vertical-align:top;text-align:left"><div style="letter-spacing: 0px; top: 0px;display:inline;"><div style="font-weight:bolder;display:inline;">2.</div></div></td>
<td style="vertical-align:top;text-align:left"><div style="margin-top: 0pt; margin-bottom: 0pt; font-size: 10pt; font-family: &quot;Times New Roman&quot;; font-weight: bold; text-align: left; line-height: normal;">PRINCIPAL ACCOUNTING POLICIES - continued </div></td></tr></table></ix:exclude></ix:continuation><ix:continuation id="TextSelectionAppend_161523886_87" continuedAt="TextSelectionAppend_161523886_88"><ix:exclude><div style="font-size:6pt;margin-top:0pt;margin-bottom:0pt">&#160;</div>
