<td style="width:4%;vertical-align:top;text-align:left"><div style="letter-spacing: 0px; top: 0px;display:inline;"><div style="font-weight:bolder;display:inline;"><div style="font-style:italic;display:inline;">2.16</div></div></div></td>
<td style="vertical-align:top;text-align:left"><div style="margin-top: 0pt; margin-bottom: 0pt; font-size: 10pt; font-family: &quot;Times New Roman&quot;; font-weight: bold; text-align: left; line-height: normal;"><div style="font-style: normal; letter-spacing: 0px; top: 0px;display:inline;"><div style="font-style:italic;display:inline;">Other <div style="white-space:nowrap;display:inline;">non-current</div> assets </div></div></div></td></tr></table><div style="margin-top:6pt; margin-bottom:0pt; font-size:10pt; font-family:Times New Roman">Other <div style="white-space: nowrap; letter-spacing: 0px; top: 0px;display:inline;">non-current</div> assets mainly consist of long-term prepayments for property and equipment, long-term prepayments for equity investment in a private company, long-term deposits and long-term interest receivable. </div></ix:nonNumeric><div style="margin-top:0pt;margin-bottom:0pt ; font-size:8pt">&#160;</div><div style="margin-top:0pt; margin-bottom:0pt; font-size:10pt; font-family:Times New Roman;text-align:center"><ix:exclude>F-26</ix:exclude> </div></ix:continuation></div></div><ix:continuation id="TextSelectionAppend_161523886_52" continuedAt="TextSelectionAppend_161523886_53"><ix:exclude><div style="margin-top:1em; margin-bottom:0em; page-break-before:always"></div></ix:exclude></ix:continuation><ix:continuation id="TextSelectionAppend_161523886_53" continuedAt="TextSelectionAppend_161523886_54"><ix:exclude><hr style="color:#999999;height:3px;width:100%;clear:both"/></ix:exclude></ix:continuation><ix:continuation id="TextSelectionAppend_161523886_54" continuedAt="TextSelectionAppend_161523886_55"><ix:exclude><div style="font-size: 10pt; margin-top: 1.67em; margin-bottom: 1.67em;font-weight: bold;"><div style="font-weight:bolder;display:inline;"><a href="#toc">Table of Contents</a></div></div></ix:exclude></ix:continuation><div style="width:790px"></div><div style="text-align:center"><div style="width:8.5in;text-align:left;margin-left: auto;margin-right: auto"><ix:continuation id="TextSelectionAppend_161523886_55" continuedAt="TextSelectionAppend_161523886_56"><ix:exclude>
