<td style="vertical-align:top;text-align:left"><div style="margin-top: 0pt; margin-bottom: 0pt; font-size: 10pt; font-family: &quot;Times New Roman&quot;; font-weight: bold; text-align: left; line-height: normal;">PRINCIPAL ACCOUNTING POLICIES - continued </div></td></tr></table></ix:exclude></ix:continuation><ix:continuation id="TextSelectionAppend_161523886_56" continuedAt="TextSelectionAppend_161523886_57"><div style="font-size:6pt; margin-top:0pt; margin-bottom:0pt">&#160;</div><ix:nonNumeric name="us-gaap:FairValueMeasurementPolicyPolicyTextBlock" contextRef="P01_01_2025To12_31_2025" escape="true" id="ixv-32045">
<table cellpadding="0" cellspacing="0" style="text-align:start; BORDER-COLLAPSE:COLLAPSE; font-family:Times New Roman; font-size:10pt;border-spacing:0;width:100%">
