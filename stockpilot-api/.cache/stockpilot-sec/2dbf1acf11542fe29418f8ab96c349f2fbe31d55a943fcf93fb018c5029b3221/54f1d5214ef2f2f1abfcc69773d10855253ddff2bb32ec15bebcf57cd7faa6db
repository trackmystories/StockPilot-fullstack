<td style="vertical-align:top;text-align:left"> <div style="margin-top: 0pt; margin-bottom: 0pt; font-size: 10pt; font-family: &quot;Times New Roman&quot;; font-weight: bold; text-align: left; line-height: normal;">PRINCIPAL ACCOUNTING POLICIES - continued </div> </td> </tr> </table> </ix:exclude></ix:continuation><ix:continuation id="TextSelectionAppend_161523886_68" continuedAt="TextSelectionAppend_161523886_69"><ix:exclude> <div style="font-size: 6pt; margin-top: 0px; margin-bottom: 0px;">&#160;</div>
