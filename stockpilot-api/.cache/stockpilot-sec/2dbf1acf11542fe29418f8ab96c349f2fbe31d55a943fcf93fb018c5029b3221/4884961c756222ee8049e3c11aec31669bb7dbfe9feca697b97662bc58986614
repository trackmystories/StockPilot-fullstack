<span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">and $<span id="xdx_904_eus-gaap--GainLossOnSalesOfAssetsAndAssetImpairmentCharges_c20240101__20241231_zCZroNp7myxl"><ix:nonFraction name="us-gaap:GainLossOnSalesOfAssetsAndAssetImpairmentCharges" contextRef="From2024-01-012024-12-31" id="Fact000777" format="ixt:numdotdecimal" decimals="0" unitRef="USD">146,760</ix:nonFraction></span></span><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">,
