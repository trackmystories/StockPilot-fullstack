ends to use the net proceeds for working capital and general corporate purposes.","context":"•","section":"","block":21,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-395512","form":"6-K","filedAt":"2026-09-18","reportDate":"2026-06-30","cik":"0001979887","url":"https://www.sec.gov/Archives/edgar/data/1979887/000119312526395512/ck0001979887-ex99_1.htm","rawPath":"sec/raw/bc84f7befc32fc13a23fd383cbed262303ba7587788272b8a718f991c684afdc.bin","sha256":"bc84f7befc32fc13a23fd383cbed262303ba7587788272b8a718f991c684afdc"}}],"omittedEvidenceCount":0},"riskFactors":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"segmentIntelligence":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0}},"warnings":[]}