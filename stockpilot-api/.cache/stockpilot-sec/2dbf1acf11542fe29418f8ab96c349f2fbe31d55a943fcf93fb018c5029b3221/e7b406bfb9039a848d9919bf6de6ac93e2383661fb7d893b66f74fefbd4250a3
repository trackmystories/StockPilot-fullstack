89e7a212adcb3810d0f20682b2fc7d25eaee5ec3eafc38d3b33681c5d9e37551{"version":1,"source":{"accession":"0001617640-26-000060","form":"8-K","filedAt":"2026-09-17","reportDate":"2026-09-16","cik":"0001617640","url":"https://www.sec.gov/Archives/edgar/data/1617640/000161764026000060/z-20260916.htm","rawPath":"sec/raw/241272f9abff95e976ab8dc945b5e13d1e018a82dee6bcc654eec3d3158a3b84.bin","sha256":"241272f9abff95e976ab8dc945b5e13d1e018a82dee6bcc654eec3d3158a3b84"},"layers":{"businessProfile":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"operatingKpis":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"managementExplanations":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"materialEvents":{"status":"evidence_available","evidence":[{"id":"b760a423f94726d58eb93c8840067f5b84119848877de89eeaefd1c5ad469a5d","quote":"In connection with this transition, on September 16, 2026, the board of directors of the Company (the “Board”) appointed Rikki Tremblay as Zillow’s Vice President, Principal Accounting Officer, effective September 17, 2026.","context":"Jennifer Rock has notified Zillow Group, Inc. (“Zillow” or “the Company”) that she will retire from her position as Zillow’s Chief Accounting Officer and principal accounting officer, effective September 17, 2026. Ms. Rock will remain employed by Zillow in an advisory role through March 1, 2027. Ms. Rock’s decision to retire was not the result of any disagreement with the Company on any matter relating to the Company’s operations, policies or practices, including accounting principles or practices, or financial disclosures.","section":"","block":23,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001617640-26-000060","form":"8-K","filedAt":"2026-09-17","reportDate":"2026-09-16","cik":"0001617640","url":"https://www.sec.gov/Archives/edgar/data/1617640/000161764026000060/z-20260916.htm","rawPath":"sec/raw/241272f9abff95e976ab8dc945b5e13d1e018a82dee6bcc654eec3d3158a3b84.bin","sha256":"241272f9abff95e976ab8dc945b5e13d1e018a82dee6bcc654eec3d3158a3b84"}},{"id":"a8fda1b2b348db14a1c4a056e4679a96cc2fcd14215bca20ba50503b66f7e98c","quote":"There are no arrangements or understandings between Ms. Tremblay and any other persons pursuant to which Ms. Tremblay was appointed as the Company’s Vice President, Principal Accounting Officer. Ms. Tremblay does not have any family relationship with any director or executive officer of the Company or any person nominated or chosen by the Company to become a director or executive officer. Other than her employment relationship with the Company as disclosed herein and her compensation and benefits in connection with such employment relationship, there are no transactions in which Ms. Tremblay has an interest requiring disclosure under Item 404(a) of Regulation S-K.","context":"Ms. Tremblay, 41, has served in various roles at Zillow since December 2014. Prior to her appointment as Vice President, Principal Accounting Officer, Ms. Tremblay served as Vice President, Reporting, Technical Accounting and Controls from February 2025 to September 2026. She served as Senior Director, Reporting, Technical Accounting and Controls from February 2023 to February 2025; Senior Director, Financial Reporting and Technical Accounting from February 2019 to February 2023; and in various other financial reporting and accounting leadership positions from December 2014 to February 2019. Prior to joining Zillow, Ms. Tremblay served in various audit roles at Deloitte & Touche LLP from September 2009 to November 2014, most recently as an audit manager. Ms. Tremblay holds two B.A. degrees from the University of Washington and is a Certified Public Accountant licensed in the State of Washington.","section":"","block":25,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001617640-26-000060","form":"8-K","filedAt":"2026-09-17","reportDate":"2026-09-16","cik":"0001617640","url":"https://www.sec.gov/Archives/edgar/data/1617640/000161764026000060/z-20260916.htm","rawPath":"sec/raw/241272f9abff95e976ab8dc945b5e13d1e018a82dee6bcc654eec3d3158a3b84.bin","sha256":"241272f9abff95e976ab8dc945b5e13d1e018a82dee6bcc654eec3d3158a3b84"}}],"omittedEvidenceCount":0},"riskFactors":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"segmentIntelligence":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0}},"warnings":[]}