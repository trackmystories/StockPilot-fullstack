  <div class="main-content-container" style="z-index:5;position:relative;"><p style="font-size:10pt;margin-top:6pt;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:8pt;font-family:Arial;font-kerning:none;min-width:fit-content;">In Canada:</span></p><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-size:5pt;font-family:Arial;font-kerning:none;min-width:fit-content;">&#160;</span></p>
