he legislation.","context":"Impact of Tax Law Changes","section":"Performance Metrics","block":425,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001041061-26-000084","form":"10-K","filedAt":"2026-02-20","reportDate":"2025-12-31","cik":"0001041061","url":"https://www.sec.gov/Archives/edgar/data/1041061/000104106126000084/yum-20251231.htm","rawPath":"sec/raw/7e683bb8184e1ae1ff19697062238f23d110433527d1cfcb0a4be32464c0e4fd.bin","sha256":"7e683bb8184e1ae1ff19697062238f23d110433527d1cfcb0a4be32464c0e4fd"}},{"id":"00884f7af4e6053bc3952d57871adfe81cd39434b0d06e4e22bf7dfdc4f83107","quote":"Fiscal 2024 included a 53rd week for all of our U.S. and certain international subsidiaries that operate on a period calendar. See Note 2 for additional details related to our fiscal calendar. The following table summarizes the estimated impact of the 53rd week on Revenues and Operating Profit for the year ended December 31, 2024. The 53rd week in 2024 favorably impacted Diluted EPS by approximately $0.09 per share.","context":"Extra Week in 2024","section":"Performance Metrics","block":427,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001041061-26-000084","form":"10-K","filedAt":"2026-02-20","reportDate":"2025-12-31","cik":"0001041061","url":"https://www.sec.gov/Archives/edgar/data/1041061/000104106126000084/yum-20251231.htm","rawPath":"sec/raw/7e683bb8184e1ae1ff19697062238f23d110433527d1cfcb0a4be32464c0e4fd.bin","sha256":"7e683bb8184e1ae1ff19697062238f23d110433527d1cfcb0a4be32464c0e4fd"}},{"id":"4afc649312337a3be7b2503dd4f8f1ca1be8f220ea14ec4d1c42cf809cf60cbc","quote":"| | | | | | | | | | | | | | | | | | | | | | | | | | | | | | KFC Division | | Taco Bell Division | | Pizza Hut Division | | Habit Burger & Grill Division | | Total Revenues | | | | | | | | | Company sales | $ | 16 | | | $ | 21 | | | $ | — | | | $ | 9 | |