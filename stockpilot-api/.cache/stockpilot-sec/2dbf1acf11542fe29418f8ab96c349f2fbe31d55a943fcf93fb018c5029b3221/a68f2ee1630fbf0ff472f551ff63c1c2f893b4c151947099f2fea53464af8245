    <td style="font: 10pt Times New Roman, Times, Serif; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_908_eus-gaap--PropertyPlantAndEquipmentUsefulLife_iI_dtY_c20251231__us-gaap--PropertyPlantAndEquipmentByTypeAxis__us-gaap--SoftwareDevelopmentMember_zVyFm6w0Wz23"><ix:nonNumeric contextRef="AsOf2025-12-31_us-gaap_SoftwareDevelopmentMember" format="ixt-sec:duryear" id="Fact001578" name="us-gaap:PropertyPlantAndEquipmentUsefulLife">3</ix:nonNumeric></span>
    years</span></td></tr>
  <tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Vehicles</span></td>
    <td><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_906_eus-gaap--PropertyPlantAndEquipmentUsefulLife_iI_dtY_c20251231__us-gaap--PropertyPlantAndEquipmentByTypeAxis__us-gaap--VehiclesMember_zrgGzezi3q53" title="Estimated useful lives"><ix:nonNumeric contextRef="AsOf2025-12-31_us-gaap_VehiclesMember" format="ixt-sec:duryear" id="Fact001580" name="us-gaap:PropertyPlantAndEquipmentUsefulLife">3</ix:nonNumeric></span>
    years</span></td></tr>
