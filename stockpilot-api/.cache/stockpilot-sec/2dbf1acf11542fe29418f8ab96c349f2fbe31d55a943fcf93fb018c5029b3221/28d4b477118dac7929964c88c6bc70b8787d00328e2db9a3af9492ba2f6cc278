fb4b1fda51abfbb055dd6f88526f6ecd6e3207407c4b3491a3e8f9b99b7d","quote":"The Group’s historical financial and operating performance may not be indicative of its future prospects and results of operations due to the limited operating history of some of the Group’s business lines, evolving business model and changing market;","context":"•","section":"Risk Factors","block":334,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-153778","form":"20-F","filedAt":"2026-04-14","reportDate":"2025-12-31","cik":"0001838413","url":"https://www.sec.gov/Archives/edgar/data/1838413/000119312526153778/d20504d20f.htm","rawPath":"sec/raw/f8d7fa4eb0ccc9663f08239805aff92d90566532ca4fec19d089c5682f0c5dc0.bin","sha256":"f8d7fa4eb0ccc9663f08239805aff92d90566532ca4fec19d089c5682f0c5dc0"}},{"id":"6c36edfdf52e48e5e32f21a93610051321f286b6207f008da2f0c4b7bbe4bd5c","quote":"The Group’s operations have grown substantially since inception. We may not be able to effectively manage the Group’s growth, control the Group’s expenses or implement the Group’s business strategies;","context":"•","section":"Risk Factors","block":336,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001193125-26-153778","form":"20-F","filedAt":"2026-04-14","reportDate":"2025-12-31","cik":"0001838413","url":"https://www.sec.gov/Archives/edgar/data/1838413/000119312526153778/d20504d20f.htm","rawPath":"sec/raw/f8d7fa4eb0ccc9663f08239805aff92d90566532ca4fec19d089c5682f0c5dc0.bin","sha256":"f8d7fa4eb0ccc9663f08239805aff92d90566532ca4fec19d089c5682f0c5dc0"}},{"id":"3f3dec9b0ff9a1447bc62d3602a969d13721d7a402066d00b1299132f694ef5b","quote":"The Group’s business may be affected by fluctuations in China’s road transportation market;","context":"•","section":"Risk Factors","block":338,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_