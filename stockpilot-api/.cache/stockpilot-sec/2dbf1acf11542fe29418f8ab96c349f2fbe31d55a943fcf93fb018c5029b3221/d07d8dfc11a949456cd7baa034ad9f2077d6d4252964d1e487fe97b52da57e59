<ix:continuation continuedAt="yygh_DescriptionOfAccountingPolicyForExpectedCreditLosses-c0_cont_2" id="yygh_DescriptionOfAccountingPolicyForExpectedCreditLosses-c0_cont_1"><table cellpadding="0" style="font: 10pt Times New Roman, Times, Serif; width: 100%; border-spacing: 3px;">
  <tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
