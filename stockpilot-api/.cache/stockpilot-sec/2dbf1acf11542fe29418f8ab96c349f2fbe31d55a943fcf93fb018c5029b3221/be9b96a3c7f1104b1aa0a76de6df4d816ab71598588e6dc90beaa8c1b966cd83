ring. The Company has also agreed to reimburse the Placement Agent for up to $80,000 for its out-of-pocket expenses related to the Offering, including any reasonable fees, costs and disbursements of the Placement Agent’s legal counsel’s expenses, and travel costs in connection with the Offering.","context":"1","section":"","block":30,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001213900-26-081889","form":"6-K","filedAt":"2026-07-28","reportDate":"2026-07-27","cik":"0001785566","url":"https://www.sec.gov/Archives/edgar/data/1785566/000121390026081889/ea0299141-6k_zhongchao.htm","rawPath":"sec/raw/dc927c830d5dedaa508efb615fab5dc76dcda8ae948bacce49e051cd617db203.bin","sha256":"dc927c830d5dedaa508efb615fab5dc76dcda8ae948bacce49e051cd617db203"}}],"omittedEvidenceCount":0},"riskFactors":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"segmentIntelligence":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0}},"warnings":[]}