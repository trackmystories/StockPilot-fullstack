</ix:nonNumeric><ix:nonNumeric contextRef="From2026-01-01to2026-06-30" escape="true" id="Fact000918" name="ZJK:ShortTermInvestmentsPolicyTextBlock"><p id="xdx_84A_ecustom--ShortTermInvestmentsPolicyTextBlock_zy9KWUoMWis7" style="font: 10pt Times New Roman, Times, Serif; margin: 0; text-align: justify">&#160;</p>

<p style="font: 10pt Times New Roman, Times, Serif; margin: 0; text-align: justify"></p>

<table cellspacing="0" cellpadding="0" style="font: 10pt Times New Roman, Times, Serif; width: 100%">
  <tr style="vertical-align: top">
    <td style="width: 9px">&#160;</td>
