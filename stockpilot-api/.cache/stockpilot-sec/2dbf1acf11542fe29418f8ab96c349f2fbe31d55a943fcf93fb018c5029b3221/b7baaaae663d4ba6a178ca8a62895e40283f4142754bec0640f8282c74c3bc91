<TD STYLE="width: 0.25in"></TD><TD STYLE="width: 0.25in">&#9679;</TD><TD STYLE="text-align: justify">Digital and smart-technology application skills training;</TD></TR><TR STYLE="vertical-align: top">
<TD>&nbsp;</TD><TD>&nbsp;</TD><TD STYLE="text-align: justify">&nbsp;</TD></TR>
                                                                                                                                                                                                                  </TABLE>

<TABLE CELLPADDING="0" CELLSPACING="0" STYLE="font: 10pt Times New Roman, Times, Serif; margin-top: 0pt; margin-bottom: 0pt; width: 100%"><TR STYLE="vertical-align: top">
