<p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>&#160;</b></span></p>

<ix:nonNumeric contextRef="From2025-01-01to2025-12-31" escape="true" id="Fact000528" name="us-gaap:BasisOfAccountingPolicyPolicyTextBlock"><p id="xdx_844_eus-gaap--BasisOfAccountingPolicyPolicyTextBlock_zGCQxY4fQnCf" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0pt 0pt 0; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt; background-color: white"><b><i>Basis
