                                            &#8211; <span id="xdx_90D_eifrs-full--UsefulLifeMeasuredAsPeriodOfTimePropertyPlantAndEquipment_dtY_c20250401__20260331__ifrs-full--ClassesOfPropertyPlantAndEquipmentAxis__ifrs-full--VehiclesMember__ifrs-full--RangeAxis__ifrs-full--TopOfRangeMember_z78pRafqfrah"><ix:nonNumeric contextRef="From2025-04-012026-03-31_ifrs-full_VehiclesMember_ifrs-full_TopOfRangeMember" format="ixt-sec:duryear" id="Fact001502" name="ifrs-full:UsefulLifeMeasuredAsPeriodOfTimePropertyPlantAndEquipment">7</ix:nonNumeric></span> years</span></td></tr>
<tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
    <td style="font: 10pt Times New Roman, Times, Serif">&#160;</td>
<td style="font: 10pt Times New Roman, Times, Serif"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt">Building</span></td>
    <td style="font: 10pt Times New Roman, Times, Serif">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_908_eifrs-full--UsefulLifeMeasuredAsPeriodOfTimePropertyPlantAndEquipment_dtY_c20250401__20260331__ifrs-full--ClassesOfPropertyPlantAndEquipmentAxis__ifrs-full--BuildingsMember_zEY2kyxL9L5"><ix:nonNumeric contextRef="From2025-04-012026-03-31_ifrs-full_BuildingsMember" format="ixt-sec:duryear" id="Fact001503" name="ifrs-full:UsefulLifeMeasuredAsPeriodOfTimePropertyPlantAndEquipment">60</ix:nonNumeric></span>
