 complies in all respects with the U.S. federal and applicable state securities laws, and are not and will not be or constitute a part of any activity that is or may be deemed to be illegal under the U.S. federal or applicable state securities laws, including, without limitation, being a part of any illegal offering, illegal pump-and-dump, illegal scalping, illegal touting schemes, or an effort to assist with a violation of any court order including, but not limited to, any order banning or limiting a person’s involvement in the securities markets.","section":"","block":25,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001185185-26-003845","form":"6-K","filedAt":"2026-09-04","reportDate":"2026-09-04","cik":"0001729214","url":"https://www.sec.gov/Archives/edgar/data/1729214/000118518526003845/xortxex99-1.htm","rawPath":"sec/raw/bad979eace67bf7a7ec10cfd049abaa12dfde464845d9c4ab65a90b327e7c1a9.bin","sha256":"bad979eace67bf7a7ec10cfd049abaa12dfde464845d9c4ab65a90b327e7c1a9"}}],"omittedEvidenceCount":0},"riskFactors":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"segmentIntelligence":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0}},"warnings":[]}]