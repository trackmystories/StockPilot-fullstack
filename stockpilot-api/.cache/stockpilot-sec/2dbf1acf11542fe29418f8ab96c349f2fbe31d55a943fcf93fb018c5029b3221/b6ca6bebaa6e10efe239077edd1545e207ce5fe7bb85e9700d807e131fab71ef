b362d363b08c6a9"}},{"id":"f9d5aaf5492e9e9eebce0441b0c317a466b78178a6b545fe90cfc34b47ef8526","quote":"•the diversion of our management’s attention from our existing programs and initiatives in pursuing such a strategic merger or acquisition;","context":"•assimilation of operations, intellectual property and products of an acquired company, including difficulties associated with integrating new personnel;","section":"Business interruptions could adversely affect our operations.","block":833,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001725160-26-000062","form":"10-Q","filedAt":"2026-08-06","reportDate":"2026-06-30","cik":"0001725160","url":"https://www.sec.gov/Archives/edgar/data/1725160/000172516026000062/zntl-20260630.htm","rawPath":"sec/raw/6b2c9b180128337bb06069cbfa341de046d7bfd2cf9b16103b362d363b08c6a9.bin","sha256":"6b2c9b180128337bb06069cbfa341de046d7bfd2cf9b16103b362d363b08c6a9"}},{"id":"99c424bbafc7c8f49c9dabbfd609e7a73af64bdf82b521ceaababa5abc77306a","quote":"•retention of key employees, the loss of key personnel and uncertainties in our ability to maintain key business relationships;","context":"•the diversion of our management’s attention from our existing programs and initiatives in pursuing such a strategic merger or acquisition;","section":"Business interruptions could adversely affect our operations.","block":834,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001725160-26-000062","form":"10-Q","filedAt":"2026-08-06","reportDate":"2026-06-30","cik":"0001725160","url":"https://www.sec.gov/Archives/edgar/data/1725160/000172516026000062/zntl-20260630.htm","rawPath":"sec/raw/6b2c9b180128337bb06069cbfa341de046d7bfd2cf9b16103b362d363b08c6a9.bin","sha256":"6b2c9b180128337bb06069cbfa341de046d7bfd2cf9b16103b362d363b08c6a9"}},{"id":"c05d3b9f0184cfcdaa01ecb9df6f3972fc8df4c21130c4f713be622172d5