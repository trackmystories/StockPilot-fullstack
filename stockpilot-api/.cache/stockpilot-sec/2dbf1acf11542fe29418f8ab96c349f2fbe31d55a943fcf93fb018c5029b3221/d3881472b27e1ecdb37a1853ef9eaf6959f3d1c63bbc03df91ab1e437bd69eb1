cf19924a8c5fd28f7ddbb91f25eac2428e770d67ebbbd69487bb10fcc1226993{"version":1,"source":{"accession":"0001628280-26-012614","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0000110471","url":"https://www.sec.gov/Archives/edgar/data/110471/000162828026012614/a2025-q4ex1013thirdamendme.htm","rawPath":"sec/raw/e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92.bin","sha256":"e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92"},"layers":{"businessProfile":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"operatingKpis":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"managementExplanations":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"materialEvents":{"status":"evidence_available","evidence":[{"id":"1ccad94fabdbc12f132d0abac80344bb333b1ea80e96e9243e06fae02688ce22","quote":"A Participant who has 5 Years of Service for vesting purposes after the effective date of either a Participation Agreement under this plan, a Participation Agreement under the Grandfathered SERP, or a written deferred compensation agreement previously entered into between the Participant and the Company (a \"Deferred Compensation Agreement\"), or who has reached age 65 before Retiring, will be entitled to a benefit computed under this Section, unless the benefit is forfeited under Article 6. For purposes of this Article 5 and Article 7, the terms \"Retiring\" or \"Retire\" shall include an Employee's Termination of Employment.","context":"5.1 Retirement Benefits.","section":"","block":13,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001628280-26-012614","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0000110471","url":"https://www.sec.gov/Archives/edgar/data/110471/000162828026012614/a2025-q4ex1013thirdamendme.htm","rawPath":"sec/raw/e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92.bin","sha256":"e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92"}}],"omittedEvidenceCount":0},"riskFactors":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"segmentIntelligence":{"status":"evidence_available","evidence":[{"id":"2b3ba77fcf6461921fda15e59dd1bfe2b44d50d3f050d414dfc4f3ace6a16f0f","quote":"(i) Age of Commencement. If the Participant begins receiving a benefit between age 60 and 65, the actuarially equivalent reduction in the benefit amount shall be .1666% (1/6 of 1%) for each month between the date the benefit begins and the first day of the month following the month in which the Participant would attain age 65. If the Participant begins receiving benefits between age 55 and 60, the actuarially equivalent reduction shall be an additional .333% (1/3 of 1%) for each month between the date the benefit begins and the first day of the month following the month in which the Participant would attain age 60. For avoidance of doubt, and consistent with Section 7.3, if the Participant (other than an Inactive Participant) begins receiving a benefit at least 12 months after attaining age 65 (not including any applicable Specified Employee postponement), the Participant's Annual Benefit will be adjusted for late payment using the applicable interest rate specified in Section 2.5, subject to any minimum or maximum rates determined annually based on the appropriate segment rate(s) determined by the Administrator for the Participant.","context":"(b) Actuarial Adjustments. If payment to the Participant commences prior to or after the date the Participant attains age 65 or in a form other than a single life annuity, the Participant's Annual Benefit shall be adjusted in accordance with the following provisions.","section":"","block":25,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001628280-26-012614","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0000110471","url":"https://www.sec.gov/Archives/edgar/data/110471/000162828026012614/a2025-q4ex1013thirdamendme.htm","rawPath":"sec/raw/e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92.bin","sha256":"e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92"}},{"id":"2cf7edb3ee1451b56cf7d0e99518c43bd03e9241dead3fe2b878daa70ecd8aac","quote":"(ii) Form. All forms of payment will be actuarially equivalent to the benefit payable as a single life annuity. If payment is made in a form other than a single life annuity, the amount of the benefit shall be adjusted based on the actuarial factors determined under Section 2.5.","context":"(i) Age of Commencement. If the Participant begins receiving a benefit between age 60 and 65, the actuarially equivalent reduction in the benefit amount shall be .1666% (1/6 of 1%) for each month between the date the benefit begins and the first day of the month following the month in which the Participant would attain age 65. If the Participant begins receiving benefits between age 55 and 60, the actuarially equivalent reduction shall be an additional .333% (1/3 of 1%) for each month between the date the benefit begins and the first day of the month following the month in which the Participant would attain age 60. For avoidance of doubt, and consistent with Section 7.3, if the Participant (other than an Inactive Participant) begins receiving a benefit at least 12 months after attaining age 65 (not including any applicable Specified Employee postponement), the Participant's Annual Benefit will be adjusted for late payment using the applicable interest rate specified in Section 2.5, subject to any minimum or maximum rates determined annually based on the appropriate segment rate(s) determined by the Administrator for the Participant.","section":"","block":26,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001628280-26-012614","form":"10-K","filedAt":"2026-02-27","reportDate":"2026-01-03","cik":"0000110471","url":"https://www.sec.gov/Archives/edgar/data/110471/000162828026012614/a2025-q4ex1013thirdamendme.htm","rawPath":"sec/raw/e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92.bin","sha256":"e8196e76ee8e60ba2acc9ed60bb99e7b92df30392d7a7442a7f39d0c21765a92"}}],"omittedEvidenceCount":0}},"warnings":[]}