42361e4cd6c157791cd805543fed7b94079a4a27489466da6092fd7db3aeca27{"version":1,"source":{"accession":"0001713683-26-000156","form":"8-K","filedAt":"2026-09-03","reportDate":"2026-09-01","cik":"0001713683","url":"https://www.sec.gov/Archives/edgar/data/1713683/000171368326000156/zs-07312026_991.htm","rawPath":"sec/raw/2b7e122f8ba7585cc63a72d591861e929a7f190faa9939cb3832f26163be6722.bin","sha256":"2b7e122f8ba7585cc63a72d591861e929a7f190faa9939cb3832f26163be6722"},"layers":{"businessProfile":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"operatingKpis":{"status":"evidence_available","evidence":[{"id":"eeeecdd5df4240f2916b66b5259c88747a8afedc5938e423fdecdb878564990f","quote":"Generates Q4 and FY26 ARR growth of 25% year over year","context":"Achieves strong Q4 and FY26 revenue growth of 25% year over year","section":"","block":4,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001713683-26-000156","form":"8-K","filedAt":"2026-09-03","reportDate":"2026-09-01","cik":"0001713683","url":"https://www.sec.gov/Archives/edgar/data/1713683/000171368326000156/zs-07312026_991.htm","rawPath":"sec/raw/2b7e122f8ba7585cc63a72d591861e929a7f190faa9939cb3832f26163be6722.bin","sha256":"2b7e122f8ba7585cc63a72d591861e929a7f190faa9939cb3832f26163be6722"}},{"id":"f43a168cb1b661a23e05fda1a1ad12ab47632ad26d8a83d5db52e7bcca10710c","quote":"“We delivered a strong fourth quarter, with revenue and ARR both growing 25% year over year, net new ARR growing 24%, and non-GAAP operating margin reaching a record 24%,” said Kevin Rubin, chief financial officer of Zscaler. “Our growth engine continues to broaden beyond users, with a strong contribution from non-seat-based solutions, continued Z-Flex momentum, record large-deal activity, and improving sales productivity. I am excited about our momentum as we enter fiscal 2027.”","context":"“AI represents one of the most significant opportunities in Zscaler's history. By connecting users, workloads, branches, and now agents directly to the applications they need without placing them on the network, we are uniquely equipped to help companies both combat the threats created by agentic AI and securely deploy AI agents and models,” said Jay Chaudhry, CEO, Chairman and Founder of Zscaler. “Our continued innovation across Zero Trust SASE, Agentic SecOps, Data Security, and Security for AI is driving increased platform adoption and creating new avenues for growth, as reflected in our strong Q4 results. As AI becomes foundational to how organizations operate, we are well positioned to extend our leadership as the cybersecurity platform for the AI era.”","section":"","block":7,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001713683-26-000156","form":"8-K","filedAt":"2026-09-03","reportDate":"2026-09-01","cik":"0001713683","url":"https://www.sec.gov/Archives/edgar/data/1713683/000171368326000156/zs-07312026_991.htm","rawPath":"sec/raw/2b7e122f8ba7585cc63a72d591861e929a7f190faa9939cb3832f26163be6722.bin","sha256":"2b7e122f8ba7585cc63a72d591861e929a7f190faa9939cb3832f26163be6722"}},{"id":"de7b6d775f101a7df80574953abf092c39839a2f00133757246b2726cfed3f95","quote":"•ARR: Grew 25% year over year to $3,771 million, of which $246 million was net new ARR during the fourth quarter of fiscal 2026. Excluding the acquisition of Red Canary, which contributed ARR of $141 million, ARR grew 20% to $3,630 million and net new ARR grew 17%.","context":"•Revenue: Grew 25% year over year to $898.2 million.","section":"","block":10,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001713683-26-000156","form":"8-K","filedAt":"2026-09-03","reportDate":"2026-09-01","cik":"0001713683","url":"https://www.sec.gov/Archives/edgar/data/1713683/000171368326000156/zs-07312026_991.htm","rawPath":"sec/r