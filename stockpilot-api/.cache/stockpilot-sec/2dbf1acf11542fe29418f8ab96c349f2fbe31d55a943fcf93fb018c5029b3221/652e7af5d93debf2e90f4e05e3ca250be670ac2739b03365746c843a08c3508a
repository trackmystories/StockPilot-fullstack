<TABLE CELLPADDING="0" CELLSPACING="0" STYLE="font: 10pt Times New Roman, Times, Serif; width: 100%; margin-top: 0; margin-bottom: 6pt"><TR STYLE="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
