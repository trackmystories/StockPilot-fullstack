    <td style="white-space: nowrap; padding-bottom: 0.05pt; text-align: center; font-size: 10pt"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:nonNumeric contextRef="c139" format="ixt-sec:duryear" name="us-gaap:PropertyPlantAndEquipmentUsefulLife" id="ixv-20622">3</ix:nonNumeric>-<ix:nonNumeric contextRef="c140" format="ixt-sec:duryear" name="us-gaap:PropertyPlantAndEquipmentUsefulLife" id="ixv-20623">10</ix:nonNumeric>&#160;years</span></td></tr>
