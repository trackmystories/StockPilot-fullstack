<DIV style=margin-left:72pt;width:468pt><P align=right style='font:11pt Times New Roman;margin:0'><B>Exhibit 99.5</B></P>
<HR style='border:0;height:0;width:0;margin:14pt 0 0 0'><P align=center style='font:15pt Times New Roman;margin-top:0pt;margin-bottom:8pt'><IMG src=ztex99z5_1.jpg width=293 height=116 alt='Picture 1' title='Picture 1'>&nbsp;</P>
