9f4ebba3eed6cab91f0e331cce95537bcc29f295a535e2b24fe30b11326fa189[{"version":1,"source":{"accession":"0001437749-26-001542","form":"10-K/A","filedAt":"2026-01-20","reportDate":"2025-09-30","cik":"0001644903","url":"https://www.sec.gov/Archives/edgar/data/1644903/000143774926001542/ycbd20250930_10ka.htm","rawPath":"sec/raw/8112209be9a78f850cf461f7345a8c9125c094b2f991d5e327eefccc3f8bb2dc.bin","sha256":"8112209be9a78f850cf461f7345a8c9125c094b2f991d5e327eefccc3f8bb2dc"},"layers":{"businessProfile":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"operatingKpis":{"status":"evidence_available","evidence":[{"id":"dc7fe34813799c2e3d3f4e04dcb015035a71eaeac3f106d829d06ac9242dd6ce","quote":"| ● | all individuals serving as our principal executive officer or acting in a similar capacity during fiscal 2025; | ● | our two most highly compensated named executive officers at September 30, 2025 whose annual compensation exceeded $100,000; and | ● | up to two additional individuals for whom disclosure would have been made in this table but for the fact that the individual was not serving as a named executive officer of our company at September 30, 2025.","context":"The following table summarizes all compensation recorded by us in each of the last two completed fiscal years for:","section":"ITEM 11. EXECUTIVE COMPENSATION.","block":98,"table":" | ● | all individuals serving as our principal executive officer or acting in a similar capacity during fiscal 2025;\n | ● | our two most highly compensated named executive officers at September 30, 2025 whose annual compensation exceeded $100,000; and\n | ● | up to two additional individuals for whom disclosure would have been made in this table but for the fact that the individual was not serving as a named executive officer of our company at September 30, 2025.","attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001437749-26-001542","form":"10-K/A","filedAt":"2026-01-20","reportDate":"2025-09-30","cik":"0001644903","url":"https://www.sec.gov/Archives/edgar/data/1644903/000143774926001542/ycbd20250930_10ka.htm","rawPath":"sec/raw/8112209be9a78f850cf461f7345a8c9125c094b2f991d5e327eefccc3f8bb2dc.bin","sha256":"8112209be9a78f850cf461f7345a8c9125c094b2f991d5e327eefccc3f8bb2dc"}}],"omittedEvidenceCount":0},"managementExplanations":{"status":"no_evidence","evidence":[],"omittedEvidenceCount":0},"materialEvents":{"status":"evidence_available","evidence":[{"id":"641f0976c8157cbc77e7f20b9a60f4f5edc3453b064c7a6eed9e704be9f6a2fe","quote":"Ronan Kennedy. Mr. Kennedy has served as our Chief Financial Officer since October 2020. On March 3, 2021, he was appointed to serve as our Chief Operating Officer. On March 1, 2023, he was appointed Interim Chief Executive Officer and resigned as Chief Operating Officer. During March 2024 he was appointed full time chief executive officer. He has served as a member of our board of directors since December 2024. Prior to joining cbdMD, he served as Chief Financial Officer of AMV Holdings, LLC, a Mooresville, NC-based vaping and e-cigarette retailer, manufacturer and wholesaler from 2015 through October 2020. During his tenure, AMV grew from a nine-store regional chain to a platform of over 100 U.S. locations and a growing European footprint. Following the passing of the Farm Bill in late 2018, Mr. Kennedy assisted AMV expand into the manufacturing and retailing of CBD products. Prior to his role at AMV, Mr. Kennedy spent nine years at Meriturn Partners, LLC, a Raleigh, NC-based middle-market private equity firm focused on acquiring and advising middle-market companies, where he was a Principal. In his role with Meriturn Partners, LLC, Mr. Kennedy has led all facets of transactions, including due diligence, financial analysis and capital raising and in 2014 helped lead Meriturn’s original acquisition of AMV’s predecessor. Since 2014, Mr. Kennedy has also provided independent advisory and consulting services with select organizations and his engagements have included leading the financial analysis on sale-side engagements, assistance in negotiating a $40 million sale to a strategic buyer, advising secured creditors through restructuring of a restaurant group, and serving as a co- trustee for a specialty pharmaceutical company. From 2001 to 2004, Mr. Kennedy held engineering and manufacturing roles with Visteon Corporation, a $16 billion Tier 1 automotive supplier. Mr. Kennedy received a B.S. in Mechanical Engineering from Virginia Polytechnic Institute & State University and a M.B.A. from the Fuqua School of Business, Duke University. Mr. Kennedy previously served on the Board of Directors of Nexus Capital Real Estate Inc., a Rochester, NY-based real estate investment firm.","context":"Name | Age | Positions T. Ronan Kennedy | 47 | Chief Executive Officer, Chief Financial Officer and Director Bradley Whitford | 45 | Chief Accounting Officer, Treasurer and Secretary Scott G. Stephen | 60 | Chairman of the Board of Directors Bakari Sellers | 41 | Director William F. Raines, III | 66 | Director Dr. Sibyl Swift | 45 | Director Kevin Roe | 53 | Director Jeffrey Porter | 66 | Director","section":"ITEM 10. DIRECTORS, EXECUTIVE OFFICERS AND CORPORATE GOVERNANCE.","block":65,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001437749-26-001542","form":"10-K/A","filedAt":"2026-01-20","reportDate":"2025-09-30","cik":"0001644903","url":"https://www.sec.gov/Archives/edgar/data/1644903/000143774926001542/ycbd20250930_10ka.htm","rawPath":"sec/raw/8112209be9a78f850cf461f7345a8c9125c094b2f991d5e327eefccc3f8bb2dc.bin","sha256":"8112209be9a78f850cf461f7345a8c9125c094b2f991d5e327eefccc3f8bb2dc"}},{"id":"efb9d9956d069bb17bba7c639638fd293f2e7823310e76cde08cbbab11198dfd","quote":"T. Ronan Kennedy. Mr. Kennedy was employed by the Company under an Executive Employment Agreement dated October 1, 2021. Effective November 28, 2025, the Company entered into an Executive Employment Agreement with Mr. Kennedy to serve as our Chief Executive Officer and Chief Financial Officer (the “Kennedy Employment Agreement”). The material terms of the agreement are as follows:","context":"Executive Employment Agreements","section":"ITEM 11. EXECUTIVE COMPENSATION.","block":105,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001437749-26-001542","form":"10-K/A","filedAt":"2026-01-20","reportDate":"2025-09-30","cik":"0001644903","url":"https://www.sec.gov/Archives/edgar/data/1644903/000143774926001542/ycbd20250930_10ka.htm","rawPath":"sec/raw/8112209be9a78f850cf461f7345a8c9125c094b2f991d5e327eefccc3f8bb2dc.bin","sha256":"8112209be9a78f850cf461f7345a8c9125c094b2f991d5e327eefccc3f8bb2dc"}},{"id":"0fa20594dd4d6d0a3a79221238c65f237ef255b591f649b4ddc70458a8a62bc8","quote":"On November 28, 2025, the board of directors of the Company approved the 2025 Equity Incentive Plan (the “2025 Plan”), as the 2015 Plan has expired and there is a nominal number of shares available under the 2021 Plan. Our board of directors will recommend that the 2025 Plan be approved by our shareholders at our upcoming 2026 annual meeting. The 2025 Plan reserves 891,316 shares of our common stock for issuance pursuant to the terms of the plan upon the grant of plan options, restricted stock awards, or other stock-based awards granted under the 2025 Plan. The 2025 Plan also contains an “evergreen formula” pursuant to which the number of shares of common stock available for issuance under the 2025 Plan will automatically increase on October 1 of each calendar year during the term of the 2025 Plan, beginning with calendar year 2026, (i) by an amount equal to 2% of the total number of shares of common stock outstanding on September 30 of the such calendar year, up to a maximum of 300,000 shares or (ii) to no more than 10% of the then number of issued and outstanding shares of the Company’s common stock as of the date of such increase. Grants under the 2025 Plan will not vest until shareholder approval is received.","context":"7","section":"ITEM 11. EXECUTIVE COMPENSATION.","block":115,"table":null,"attribution":"issuer_disclosure","interpretation":"source_excerpt_not_independently_verified","source":{"accession":"0001437749-26-001542","form":"10-K/A","filedAt":"2026-01-20","reportDate":"2025-09-30","cik":"0001644903","url":"https://www.sec.gov/Archives/edgar/data/1644903/000143774926001542/ycbd20250930_10ka.htm","rawPath":"sec/raw/8112209be9a78f850cf461f7345a8c9125c094b2f991d5e327eefccc3f8bb2dc.bin","sha256":"8112209be9a78f850cf461f7345a8c9125c094b2f991d5e327eefccc3f8bb2dc"}},{"id":"9db4c3a21abf4baaf302143c64efb615a4f5b66823ec63064c8dc729fd86db77","quote":"Unless otherwise indicated, the address of each beneficial owner in the table set forth below is care of 2101 Westinghouse Blvd., Suite A, Charlotte, NC 28273. We believe that all persons, unless otherwise noted, named in the table have sole voting and investment power with respect to all shares of our common stock shown as being owned by them. Under securities laws, a person is considered to be the beneficial owner of securities owned by him (or certain persons whose ownership is attributed to him) and that can be acquired by him within 60 days from January 16, 2026, including upon the exercise of options, warrants or convertible securities. We determine a beneficial owner’s percentage ownership by assuming that options, warrants or convertible securities that are held by him, but not those held by any other person, and which are exercisable within 60 days of the that date, have been exercised or converted.","context":"all named executive officers and directors as a group.","section":"ITEM 12. SECURITY OWNERSHIP OF CERTAIN BENEFICIAL OWNERS AND MANAGEMENT AND RELATED STOCKHOLDER MATTERS.","block":148,"table":null,"attribution":"issuer_disclosure","in